  <style>
    /* =========================================================
       ROOT / DARK DESIGN SYSTEM
    ========================================================= */
    :root {
      --bg: #0a110e;
      --surface: #111a16;
      --surface-2: #16211c;
      --surface-3: #1c2a24;

      --ink: #e8f0ec;
      --text: #c5d1cb;
      --muted: #8a9a93;
      --light-text: #6b7c74;

      --green: #1dbf73;
      --green-dark: #15a05f;
      --green-light: rgba(29, 191, 115, 0.12);
      --green-border: rgba(29, 191, 115, 0.28);
      --lime: #b8df55;

      --border: #24332c;
      --border-light: #1e2b25;

      --radius: 20px;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      --shadow-small: 0 8px 30px rgba(0, 0, 0, 0.35);

      --font-body: "DM Sans", sans-serif;
      --font-heading: "Manrope", sans-serif;

      /* Preview specific */
      --preview-bg: #0a110e;
      --preview-surface: #111a16;
      --preview-soft: #16211c;
      --preview-text: #e8f0ec;
      --preview-text-soft: #a0b0a8;
      --preview-muted: #6b7c74;
      --preview-border: #24332c;
      --preview-primary: #1dbf73;
      --preview-primary-dark: #15a05f;
      --preview-primary-soft: rgba(29, 191, 115, 0.12);
      --preview-shadow-sm: 0 8px 25px rgba(0, 0, 0, 0.35);
      --preview-shadow-lg: 0 25px 70px rgba(0, 0, 0, 0.5);
      --preview-radius-lg: 24px;
      --preview-radius-md: 18px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 100px;
      font-size: 16px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    body.menu-open { overflow: hidden; }

    a { color: inherit; text-decoration: none; }
    button, input, textarea { font-family: inherit; }
    button { cursor: pointer; }
    img { display: block; max-width: 100%; }

    ::selection { background: var(--green); color: #0a110e; }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      color: var(--ink);
    }

    .container {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
    }

    /* =========================================================
       NAVBAR
    ========================================================= */
    .navbar {
      position: fixed;
      top: 18px;
      left: 50%;
      z-index: 1000;
      transform: translateX(-50%);
      width: min(1160px, calc(100% - 30px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 12px 11px 18px;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 16px;
      background: rgba(10, 17, 14, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #fff;
      font-size: 15px;
      font-weight: 800;
      white-space: nowrap;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      overflow: hidden;
      background: linear-gradient(135deg, var(--green), var(--lime));
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-links a {
      padding: 9px 12px;
      border-radius: 9px;
      color: #a0b0a8;
      font-size: 14px;
      font-weight: 700;
      transition: color 0.25s ease, background 0.25s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #fff;
      background: rgba(255,255,255,0.08);
    }

    .nav-contact {
      display: inline-flex !important;
      align-items: center;
      gap: 6px;
      color: #0a110e !important;
      background: var(--lime) !important;
    }

    .nav-contact:hover { background: #c8ed6a !important; }

    .menu-button {
      display: none;
      width: 40px;
      height: 40px;
      border: 0;
      border-radius: 10px;
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-size: 17px;
    }

    /* =========================================================
       HERO
    ========================================================= */
    .hero {
      position: relative;
      min-height: 780px;
      padding: 170px 0 100px;
      overflow: hidden;
      background:
        radial-gradient(circle at 75% 20%, rgba(29,191,115,0.18), transparent 28%),
        radial-gradient(circle at 10% 85%, rgba(184,223,85,0.06), transparent 25%),
        linear-gradient(135deg, #060d0a, #0c1612 55%, #101c17);
      color: #fff;
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0,1fr) 340px;
      gap: 70px;
      align-items: center;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      background: rgba(255,255,255,0.04);
      color: #8aefc0;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #36d399;
      box-shadow: 0 0 0 5px rgba(54,211,153,0.15);
    }

    .hero h1 {
      max-width: 850px;
      margin-top: 24px;
      color: #fff;
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.02;
      letter-spacing: -2.5px;
      font-weight: 800;
    }

    .hero h1 span { color: var(--lime); }

    .hero-title {
      max-width: 820px;
      margin-top: 20px;
      color: #a8e0c4;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.6;
    }

    .hero-description {
      max-width: 760px;
      margin-top: 16px;
      color: #9aaba3;
      font-size: 15px;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .button {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 18px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 800;
      transition: transform 0.25s ease, background 0.25s ease;
    }

    .button-primary {
      background: var(--lime);
      color: #0a110e;
    }

    .button-primary:hover {
      transform: translateY(-2px);
      background: #c8ed6a;
    }

    .button-secondary {
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      color: #fff;
    }

    .button-secondary:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.09);
    }

    .hero-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 24px;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 11px;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      color: #9aaba3;
      font-size: 12px;
      font-weight: 600;
      transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }

    .hero-link:hover {
      color: #fff;
      border-color: rgba(184,223,85,0.3);
      background: rgba(255,255,255,0.05);
    }

    /* Profile Card */
    .profile-card {
      padding: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 30px 80px rgba(0,0,0,0.4);
    }

    .profile-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .profile-avatar {
      width: 100px;
      height: 100px;
      border: 3px solid rgba(184,223,85,0.3);
      border-radius: 22px;
      overflow: hidden;
      background: linear-gradient(135deg, #183c2b, #10251c);
    }

    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 9px;
      border-radius: 999px;
      background: rgba(54,211,153,0.12);
      color: #73e4b0;
      font-size: 10px;
      font-weight: 800;
    }

    .profile-name {
      margin-top: 20px;
      color: #fff;
      font-size: 20px;
      font-weight: 800;
    }

    .profile-role {
      margin-top: 4px;
      color: #8a9a93;
      font-size: 13px;
    }

    .profile-divider {
      height: 1px;
      margin: 20px 0;
      background: rgba(255,255,255,0.07);
    }

    .profile-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
      color: #a0b0a8;
      font-size: 13px;
    }

    .profile-item i {
      width: 18px;
      color: var(--lime);
    }

    .profile-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 14px;
    }

    .profile-stack span {
      padding: 6px 9px;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 6px;
      color: #b0c0b8;
      background: rgba(255,255,255,0.04);
      font-size: 11px;
      font-weight: 700;
    }

    /* =========================================================
       METRICS
    ========================================================= */
    .metrics {
      position: relative;
      z-index: 5;
      margin-top: -70px;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .metric {
      position: relative;
      padding: 28px 24px;
    }

    .metric:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 25px;
      right: 0;
      bottom: 25px;
      width: 1px;
      background: var(--border-light);
    }

    .metric-number {
      color: var(--ink);
      font-family: var(--font-heading);
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .metric-label {
      margin-top: 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .metric-description {
      margin-top: 8px;
      color: var(--light-text);
      font-size: 12px;
      line-height: 1.5;
    }

    /* =========================================================
       MAIN SECTIONS
    ========================================================= */
    main { padding: 100px 0; }

    .section { margin-bottom: 110px; }
    .section:last-child { margin-bottom: 0; }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 25px;
      margin-bottom: 36px;
    }

    .section-kicker {
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1.6px;
    }

    .section-title {
      margin-top: 8px;
      color: var(--ink);
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.15;
      letter-spacing: -1.2px;
      font-weight: 800;
    }

    .section-description {
      max-width: 520px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.7;
    }

    /* =========================================================
       ABOUT
    ========================================================= */
    .about-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.6fr;
      gap: 20px;
    }

    .about-card {
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow-small);
    }

    .about-card p {
      color: var(--text);
      font-size: 15px;
      line-height: 1.8;
    }

    .about-card p + p { margin-top: 14px; }
    .about-card strong { color: var(--ink); }
    .highlight { color: var(--green); font-weight: 800; }

    .focus-list { display: grid; gap: 10px; }

    .focus-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px;
      border: 1px solid var(--border-light);
      border-radius: 10px;
      background: var(--surface-2);
      color: var(--text);
      font-size: 13px;
      font-weight: 700;
    }

    .focus-icon {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: var(--green-light);
      color: var(--green);
      flex-shrink: 0;
    }

    /* =========================================================
       SKILLS
    ========================================================= */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .skill-card {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .skill-card:hover {
      transform: translateY(-4px);
      border-color: var(--green-border);
      box-shadow: var(--shadow-small);
    }

    .skill-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .skill-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--green-light);
      color: var(--green);
      font-size: 16px;
    }

    .skill-name {
      color: var(--ink);
      font-size: 15px;
      font-weight: 800;
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .tag {
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface-2);
      color: #a0b0a8;
      font-size: 12px;
      font-weight: 700;
    }

    .tag.main {
      border-color: var(--green-border);
      background: var(--green-light);
      color: var(--green);
    }

    /* =========================================================
       EXPERIENCE
    ========================================================= */
    .experience-layout {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 45px;
    }

    .experience-company {
      position: sticky;
      top: 100px;
      height: fit-content;
    }

    .experience-label {
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .experience-company h3 {
      margin-top: 8px;
      color: var(--ink);
      font-size: 22px;
      font-weight: 800;
    }

    .experience-company p {
      margin-top: 6px;
      color: var(--muted);
      font-size: 13px;
    }

    .timeline { position: relative; }

    .timeline::before {
      content: "";
      position: absolute;
      top: 8px;
      bottom: 5px;
      left: 7px;
      width: 1px;
      background: var(--border);
    }

    .experience-item {
      position: relative;
      padding-left: 40px;
      margin-bottom: 48px;
    }

    .experience-item:last-child { margin-bottom: 0; }

    .experience-dot {
      position: absolute;
      top: 6px;
      left: 0;
      width: 15px;
      height: 15px;
      border: 4px solid var(--bg);
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 1px var(--green-border);
    }

    .experience-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 12px;
    }

    .experience-role {
      color: var(--ink);
      font-size: 18px;
      font-weight: 800;
    }

    .experience-company-name {
      margin-top: 3px;
      color: var(--green);
      font-size: 13px;
      font-weight: 800;
    }

    .experience-date {
      flex: 0 0 auto;
      padding: 7px 11px;
      border-radius: 7px;
      background: rgba(245, 158, 11, 0.12);
      color: #f0b45a;
      font-size: 11px;
      font-weight: 900;
    }

    .experience-list {
      margin-top: 12px;
      padding-left: 18px;
    }

    .experience-list li {
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.65;
    }

    .experience-list li::marker { color: var(--green); }
    .experience-list strong { color: var(--ink); }

    /* =========================================================
       PROJECTS
    ========================================================= */
    .project-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;
    }

    .filter-button {
      padding: 9px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-button:hover,
    .filter-button.active {
      border-color: var(--green);
      background: var(--green);
      color: #0a110e;
    }

    .projects { display: grid; gap: 22px; }

    .project-card {
      border: 1px solid var(--border);
      border-radius: 22px;
      background: var(--surface);
      box-shadow: var(--shadow-small);
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .project-card:hover {
      transform: translateY(-5px);
      border-color: var(--green-border);
      box-shadow: 0 25px 65px rgba(0,0,0,0.4);
    }

    .project-card.featured { border-color: rgba(29,191,115,0.35); }

    .project-top {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 28px;
      padding: 28px;
    }

    .project-sidebar {
      padding: 18px;
      border: 1px solid var(--border-light);
      border-radius: 15px;
      background: linear-gradient(145deg, #14201a, #111a16);
      height: fit-content;
    }

    .project-number {
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .project-symbol {
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      margin-top: 12px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
      color: var(--green);
      font-size: 22px;
    }

    .project-category {
      margin-top: 14px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .project-mini-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 12px;
    }

    .project-mini-tags span {
      padding: 5px 8px;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--surface);
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
    }

    .project-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .project-title {
      color: var(--ink);
      font-size: 24px;
      line-height: 1.25;
      font-weight: 800;
    }

    .project-subtitle {
      margin-top: 5px;
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .project-button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border: 1px solid var(--green-border);
      border-radius: 8px;
      background: var(--green-light);
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .project-button:hover {
      background: var(--green);
      color: #0a110e;
    }

    .project-description {
      margin-top: 16px;
      color: var(--text);
      font-size: 14px;
      line-height: 1.75;
    }

    .project-description strong { color: var(--ink); }

    .project-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 20px;
    }

    .project-detail {
      padding: 14px;
      border: 1px solid var(--border-light);
      border-radius: 10px;
      background: var(--surface-2);
    }

    .detail-title {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--ink);
      font-size: 12px;
      font-weight: 900;
    }

    .detail-title i { color: var(--green); }

    .detail-text {
      margin-top: 6px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .project-features {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px 20px;
      margin-top: 18px;
      list-style: none;
    }

    .project-features li {
      position: relative;
      padding-left: 16px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .project-features li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 8px;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--green);
    }

    .project-features strong { color: var(--ink); }

    .project-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--border-light);
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .technology {
      padding: 6px 9px;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: var(--surface-2);
      color: #a0b0a8;
      font-size: 11px;
      font-weight: 800;
    }

    .project-result {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      white-space: nowrap;
    }

    .project-result i { color: var(--green); }

    /* =========================================================
       WORK PREVIEW (YouTube section)
    ========================================================= */
    #preview {
      position: relative;
      overflow: hidden;
      
    }

    #preview .preview-container {
      width: min(1380px, calc(100% - 48px));
      margin: 0 auto;
    }

    #preview .preview-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 40px;
    }

    #preview .preview-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 14px;
      margin-bottom: 15px;
      border: 1px solid rgba(29,191,115,0.2);
      border-radius: 999px;
      background: var(--preview-primary-soft);
      color: var(--preview-primary);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #preview .preview-title {
      max-width: 800px;
      margin: 0 0 15px;
      color: var(--preview-text);
      font-size: clamp(38px, 5vw, 68px);
      line-height: 1.02;
      letter-spacing: -0.045em;
      font-weight: 900;
    }

    #preview .preview-title span {
      color: var(--preview-primary);
    }

    #preview .preview-description {
      max-width: 760px;
      margin: 0;
      color: var(--preview-text-soft);
      font-size: 16px;
      line-height: 1.7;
    }

    #preview .project-count {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 20px;
      border: 1px solid var(--preview-border);
      border-radius: var(--preview-radius-md);
      background: rgba(17, 26, 22, 0.9);
      box-shadow: var(--preview-shadow-sm);
      backdrop-filter: blur(12px);
    }

    #preview .project-count-icon {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: var(--preview-primary-soft);
      color: var(--preview-primary);
      font-size: 20px;
    }

    #preview .project-count strong {
      display: block;
      margin-bottom: 4px;
      color: var(--preview-text);
      font-size: 21px;
      line-height: 1;
      font-weight: 900;
    }

    #preview .project-count small {
      color: var(--preview-muted);
      font-size: 11px;
      font-weight: 600;
    }

    #preview .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: start;
    }

    #preview .project-card {
      position: relative;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 350px;
      height: auto;
      overflow: hidden;
      border: 1px solid var(--preview-border);
      border-radius: var(--preview-radius-lg);
      background: var(--preview-surface);
      box-shadow: var(--preview-shadow-sm);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    #preview .project-card:hover {
      transform: translateY(-7px);
      border-color: rgba(29,191,115,0.35);
      box-shadow: var(--preview-shadow-lg);
    }

    #preview .project-media {
      position: relative;
      width: 100%;
      height: 185px;
      min-height: 185px;
      overflow: hidden;
      background: #07110d;
    }

    #preview .project-media iframe,
    #preview .project-media video,
    #preview .project-media img {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      object-fit: cover;
    }

    #preview .project-number {
      position: absolute;
      top: 13px;
      left: 13px;
      z-index: 2;
      padding: 6px 10px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      background: rgba(0,0,0,0.65);
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      backdrop-filter: blur(12px);
    }

    #preview .project-body {
      display: flex;
      flex-direction: column;
      flex: none;
      min-height: 165px;
      margin: 0;
      padding: 14px 16px 16px;
      gap: 0;
    }

    #preview .project-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin: 0;
      padding: 0;
      grid-template-columns: unset;
    }

    #preview .project-category {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      padding: 6px 10px;
      margin: 0;
      border-radius: 999px;
      background: var(--preview-primary-soft);
      color: var(--preview-primary);
      font-size: 9px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #preview .project-title {
      margin: 9px 0 0;
      color: var(--preview-text);
      font-size: 19px;
      line-height: 1.2;
      letter-spacing: -0.025em;
      font-weight: 850;
    }

    #preview .project-type {
      flex: 0 0 auto;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--surface-2);
      color: var(--preview-text-soft);
      font-size: 10px;
      line-height: 1.2;
      font-weight: 800;
      white-space: nowrap;
    }

    #preview .project-description {
      margin: 7px 0 0;
      color: var(--preview-text-soft);
      font-size: 11px;
      line-height: 1.5;
    }

    #preview .tech-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin: 10px 0 0;
      padding: 0;
    }

    #preview .tech {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 8px;
      border: 1px solid var(--preview-border);
      border-radius: 999px;
      background: var(--surface-2);
      color: #a0b0a8;
      font-size: 9px;
      line-height: 1.2;
      font-weight: 700;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    #preview .tech:hover {
      transform: translateY(-1px);
      border-color: rgba(29,191,115,0.35);
    }

    #preview .tech-dot {
      width: 5px;
      height: 5px;
      flex: 0 0 auto;
      border-radius: 50%;
      background: var(--preview-primary);
    }

    #preview .highlights {
      margin: 12px 0 0;
      padding: 12px;
      border: 1px solid var(--preview-border);
      border-radius: 13px;
      background: var(--preview-soft);
    }

    #preview .highlight-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 9px;
      padding: 0;
    }

    #preview .highlight-icon {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      flex: 0 0 auto;
      border-radius: 8px;
      background: var(--preview-text);
      color: #0a110e;
      font-size: 12px;
    }

    #preview .highlight-header strong {
      color: var(--preview-text);
      font-size: 11px;
      line-height: 1.2;
      font-weight: 800;
    }

    #preview .highlight-list {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #preview .highlight-list li {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      margin: 0;
      padding: 0;
      color: var(--preview-text-soft);
      font-size: 10px;
      line-height: 1.4;
    }

    #preview .highlight-list i {
      flex: 0 0 auto;
      margin-top: 2px;
      color: var(--preview-primary);
      font-size: 11px;
    }

    #preview .project-card:nth-child(2) .project-category {
      background: rgba(100,120,140,0.15);
      color: #a0b4c8;
    }

    #preview .project-card:nth-child(3) .project-category {
      background: rgba(59,130,246,0.12);
      color: #7ab0f0;
    }

    #preview .project-card:nth-child(4) .project-category {
      background: rgba(139,92,246,0.12);
      color: #b49af5;
    }

    #preview .project-card:nth-child(5) .project-category {
      background: rgba(245,158,11,0.12);
      color: #f0b45a;
    }

    #preview .project-card:nth-child(6) .project-category {
      background: rgba(239,68,68,0.12);
      color: #f08080;
    }

    #preview .preview-cta {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      margin-top: 55px;
      padding: 38px 42px;
      border-radius: 25px;
      background:
        radial-gradient(circle at 85% 50%, rgba(29,191,115,0.2), transparent 35%),
        #0a1711;
      box-shadow: var(--preview-shadow-lg);
      border: 1px solid var(--border);
    }

    #preview .preview-cta-content {
      position: relative;
      z-index: 1;
    }

    #preview .cta-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      margin-bottom: 12px;
      border-radius: 999px;
      background: rgba(29,191,115,0.15);
      color: #65e5a5;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #preview .preview-cta h3 {
      margin: 0 0 7px;
      color: #ffffff;
      font-size: clamp(24px, 3vw, 36px);
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    #preview .preview-cta p {
      max-width: 650px;
      margin: 0;
      color: #9aa9a1;
      font-size: 13px;
      line-height: 1.65;
    }

    #preview .cta-button {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 13px 20px;
      border-radius: 999px;
      background: var(--preview-primary);
      color: #06130c;
      font-size: 12px;
      font-weight: 800;
      text-decoration: none;
      white-space: nowrap;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    #preview .cta-button:hover {
      transform: translateX(3px);
      background: #35d984;
    }

    /* =========================================================
       ACHIEVEMENTS
    ========================================================= */
    .achievements-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .achievement-card {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      text-align: center;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .achievement-card:hover {
      transform: translateY(-4px);
      border-color: var(--green-border);
    }

    .achievement-number {
      color: var(--green);
      font-family: var(--font-heading);
      font-size: 36px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .achievement-label {
      margin-top: 8px;
      color: var(--ink);
      font-size: 14px;
      font-weight: 800;
    }

    .achievement-desc {
      margin-top: 6px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }

    /* =========================================================
       iOS ENGINEERING
    ========================================================= */
    .ios-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ios-card {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
    }

    .ios-card h4 {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--ink);
      font-size: 15px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .ios-card h4 i { color: var(--green); }

    .ios-card p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.65;
    }

    /* =========================================================
       EDUCATION
    ========================================================= */
    .education-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .education-card {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .education-card:hover {
      transform: translateY(-3px);
      border-color: var(--green-border);
    }

    .education-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--green-light);
      color: var(--green);
      font-size: 18px;
    }

    .degree {
      margin-top: 16px;
      color: var(--ink);
      font-size: 16px;
      font-weight: 800;
    }

    .institution {
      margin-top: 5px;
      color: var(--muted);
      font-size: 14px;
    }

    .education-meta {
      display: inline-flex;
      margin-top: 12px;
      padding: 6px 10px;
      border-radius: 6px;
      background: var(--green-light);
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
    }

    /* =========================================================
       CERTIFICATE
    ========================================================= */
    .certificate-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
      padding: 26px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--surface);
      box-shadow: var(--shadow-small);
    }

    .certificate-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .certificate-icon {
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: rgba(245, 158, 11, 0.12);
      color: #f0b45a;
      font-size: 22px;
      flex-shrink: 0;
    }

    .certificate-title {
      color: var(--ink);
      font-size: 16px;
      font-weight: 800;
    }

    .certificate-description {
      margin-top: 3px;
      color: var(--muted);
      font-size: 13px;
    }

    /* =========================================================
       CONTACT
    ========================================================= */
    .contact {
      padding: 55px;
      border-radius: 25px;
      color: #fff;
      background:
        radial-gradient(circle at 90% 10%, rgba(184,223,85,0.15), transparent 30%),
        linear-gradient(135deg, #07120d, #0c1a14);
      border: 1px solid var(--border);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 40px;
      align-items: center;
    }

    .contact-kicker {
      color: var(--lime);
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1.4px;
    }

    .contact h2 {
      margin-top: 10px;
      color: #fff;
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.15;
    }

    .contact p {
      max-width: 600px;
      margin-top: 14px;
      color: #9aaba3;
      font-size: 15px;
      line-height: 1.7;
    }

    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 22px;
    }

    .contact-action {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 10px 13px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      color: #b0c0b8;
      background: rgba(255,255,255,0.04);
      font-size: 13px;
      font-weight: 700;
    }

    .contact-action:hover {
      color: #fff;
      border-color: rgba(184,223,85,0.3);
    }

    .contact-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 20px;
      border-radius: 10px;
      background: var(--lime);
      color: #0a110e;
      font-size: 14px;
      font-weight: 900;
      white-space: nowrap;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .contact-button:hover {
      transform: translateY(-2px);
      background: #c8ed6a;
    }

    /* =========================================================
       FOOTER
    ========================================================= */
    footer {
      padding: 28px 0;
      border-top: 1px solid var(--border);
      background: var(--surface);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .footer-name {
      color: var(--ink);
      font-size: 14px;
      font-weight: 900;
    }

    .footer-text {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .footer-links {
      display: flex;
      gap: 8px;
    }

    .footer-links a {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      border-radius: 9px;
      color: var(--muted);
      font-size: 15px;
      transition: all 0.2s ease;
    }

    .footer-links a:hover {
      border-color: var(--green-border);
      background: var(--green-light);
      color: var(--green);
    }

    /* =========================================================
       UTILITIES
    ========================================================= */
    .reveal {
      opacity: 0;
      transform: translateY(25px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .back-top {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 900;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--surface);
      color: var(--ink);
      font-size: 16px;
      box-shadow: var(--shadow-small);
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: all 0.25s ease;
    }

    .back-top.show {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .back-top:hover {
      color: #0a110e;
      background: var(--green);
      border-color: var(--green);
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */
    @media (max-width: 1100px) {
      .hero-grid { grid-template-columns: minmax(0,1fr) 300px; gap: 40px; }
      .achievements-grid { grid-template-columns: repeat(2, 1fr); }
      #preview .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #preview .preview-header { align-items: flex-start; flex-direction: column; gap: 25px; }
    }

    @media (max-width: 1000px) {
      .hero { min-height: auto; }
      .hero-grid { grid-template-columns: 1fr; gap: 40px; }
      .profile-card { max-width: 480px; }
      .about-grid { grid-template-columns: 1fr; }
      .experience-layout { grid-template-columns: 1fr; gap: 28px; }
      .experience-company { position: static; }
