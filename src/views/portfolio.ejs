<style>
  :root{
    --navy:#0f1b2d;
    --navy-2:#16263d;
    --slate:#5b6b7f;
    --accent:#3b82c4;
    --accent-2:#22b8a0;
    --paper:#f7f9fb;
    --line:#e4e9ef;
    --font-display:'Sora', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
  }
  body{font-family:var(--font-body); color:var(--navy); background:var(--paper);}
  h1,h2,h3,h4,.brand,.navbar-brand{font-family:var(--font-display);}
  .mono{font-family:var(--font-mono);}
  a{text-decoration:none;}

  /* Navbar */
  .navbar{background:rgba(15,27,45,.92) !important; backdrop-filter:blur(8px);}
  .navbar-brand{font-weight:800; letter-spacing:.02em; color:#fff !important;}
  .navbar-brand .accent-dot{color:var(--accent-2);}
  .nav-link{color:rgba(255,255,255,.75) !important; font-weight:500; font-size:.92rem; padding:.5rem 1rem !important;}
  .nav-link:hover, .nav-link.active{color:#fff !important;}
  .nav-cta{background:var(--accent-2); color:#04231d !important; border-radius:6px; font-weight:600; padding:.5rem 1.1rem !important;}
  .nav-cta:hover{background:#fff; color:var(--navy) !important;}

  /* Hero */
  .hero{
    background:radial-gradient(ellipse at top right, #1b3a5c 0%, var(--navy) 55%), var(--navy);
    color:#fff; padding:150px 0 90px; position:relative; overflow:hidden;
  }
  .hero::before{
    content:''; position:absolute; inset:0;
    background-image:radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
    background-size:26px 26px; opacity:.5;
  }
  .hero .container{position:relative;}
  .eyebrow-pill{
    display:inline-flex; align-items:center; gap:8px; font-family:var(--font-mono); font-size:.78rem;
    color:var(--accent-2); background:rgba(34,184,160,.12); border:1px solid rgba(34,184,160,.35);
    padding:6px 14px; border-radius:999px; margin-bottom:22px;
  }
  .eyebrow-pill .pulse{width:8px; height:8px; border-radius:50%; background:var(--accent-2); box-shadow:0 0 0 0 rgba(34,184,160,.6); animation:pulse 2s infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,184,160,.55);} 70%{box-shadow:0 0 0 8px rgba(34,184,160,0);} 100%{box-shadow:0 0 0 0 rgba(34,184,160,0);}}
  .hero h1{font-weight:800; font-size:clamp(2.3rem,5.5vw,3.6rem); line-height:1.08; margin-bottom:18px;}
  .hero h1 .grad{background:linear-gradient(90deg,#7fd6c8,#69a8e0); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .hero p.lead{color:#b9c6d6; max-width:56ch; font-size:1.05rem;}
  .hero-stats{display:flex; gap:32px; flex-wrap:wrap; margin-top:44px; padding-top:28px; border-top:1px solid rgba(255,255,255,.12);}
  .hero-stats .stat b{display:block; font-family:var(--font-display); font-size:1.7rem; color:#fff;}
  .hero-stats .stat span{font-family:var(--font-mono); font-size:.7rem; color:#8ba3bc; text-transform:uppercase; letter-spacing:.05em;}
  .btn-accent{background:var(--accent-2); border:none; color:#04231d; font-weight:600; padding:.7rem 1.4rem; border-radius:8px;}
  .btn-accent:hover{background:#fff; color:var(--navy);}
  .btn-outline-light-custom{border:1px solid rgba(255,255,255,.4); color:#fff; padding:.7rem 1.4rem; border-radius:8px; font-weight:500;}
  .btn-outline-light-custom:hover{background:#fff; color:var(--navy);}

  /* Section shell */
  section{padding:88px 0;}
  .section-label{font-family:var(--font-mono); font-size:.75rem; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); font-weight:600;}
  .section-title{font-weight:800; font-size:clamp(1.6rem,3.4vw,2.3rem); margin:8px 0 46px;}
  .bg-alt{background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);}

  /* About */
  .about-card{background:#fff; border:1px solid var(--line); border-radius:14px; padding:28px; height:100%;}
  .about-card i{font-size:1.5rem; color:var(--accent-2); margin-bottom:14px; display:block;}

  /* Experience accordion */
  .accordion-item{border:1px solid var(--line); border-radius:12px !important; margin-bottom:16px; overflow:hidden;}
  .accordion-button{font-family:var(--font-body); font-weight:600; background:#fff; padding:22px 24px;}
  .accordion-button:not(.collapsed){color:var(--navy); background:#eef5fb; box-shadow:none;}
  .accordion-button:focus{box-shadow:none; border-color:var(--line);}
  .accordion-button::after{filter:hue-rotate(180deg);}
  .exp-role{font-weight:700; font-size:1.02rem;}
  .exp-meta{display:block; font-family:var(--font-mono); font-size:.78rem; color:var(--slate); font-weight:400; margin-top:3px;}
  .accordion-body{padding:6px 24px 26px 24px; background:#fff;}
  .accordion-body ul{margin:0; padding-left:1.1rem;}
  .accordion-body li{margin-bottom:10px; color:var(--slate); line-height:1.6; font-size:.94rem;}
  .accordion-body li b{color:var(--navy);}
  .badge-metric{background:#dff5ef; color:#0f7a63; font-family:var(--font-mono); font-weight:600;}

  /* Skills */
  .skill-cat{background:#fff; border:1px solid var(--line); border-radius:14px; padding:26px; height:100%;}
  .skill-cat h5{font-weight:700; margin-bottom:18px; display:flex; align-items:center; gap:10px;}
  .skill-cat h5 i{color:var(--accent);}
  .skill-tag{
    display:inline-block; font-family:var(--font-mono); font-size:.78rem; padding:6px 12px;
    background:#eef2f7; border:1px solid var(--line); border-radius:6px; margin:0 6px 8px 0; color:var(--navy);
  }

  /* Projects */
  .proj-card{background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; height:100%; transition:transform .2s ease, box-shadow .2s ease;}
  .proj-card:hover{transform:translateY(-4px); box-shadow:0 16px 30px rgba(15,27,45,.08);}
  .proj-card .proj-top{height:6px; background:linear-gradient(90deg,var(--accent),var(--accent-2));}
  .proj-card .card-body{padding:24px;}
  .proj-card h5{font-weight:700; margin-bottom:10px;}
  .proj-card p{color:var(--slate); font-size:.92rem; line-height:1.6;}
  .tech-chip{font-size:.68rem; font-family:var(--font-mono); background:#eef2f7; color:var(--navy); border-radius:5px; padding:3px 8px; margin:0 5px 5px 0; display:inline-block;}
  .proj-card .btn{font-size:.82rem;}

  /* Education */
  .edu-item{display:flex; gap:20px; padding:20px 0; border-bottom:1px solid var(--line);}
  .edu-item:last-child{border-bottom:none;}
  .edu-badge{
    flex:0 0 auto; width:56px; height:56px; border-radius:10px; background:#eef5fb; color:var(--accent);
    display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:700; font-size:.78rem;
  }
  .edu-info h6{font-weight:700; margin-bottom:2px;}
  .edu-info span.inst{color:var(--slate); font-size:.88rem;}
  .edu-info span.date{font-family:var(--font-mono); font-size:.78rem; color:var(--slate); margin-left:auto;}

  /* Contact / footer */
  .footer-cta{
    background:linear-gradient(120deg, var(--navy), var(--navy-2)); color:#fff; border-radius:20px;
    padding:56px 40px; position:relative; overflow:hidden;
  }
  .footer-cta h2{font-weight:800; max-width:18ch;}
  .footer-cta p{color:#b9c6d6; max-width:48ch;}
  footer.site-footer{padding:28px 0; font-family:var(--font-mono); font-size:.78rem; color:var(--slate); text-align:center;}

  ::selection{background:var(--accent-2); color:#04231d;}
</style>
</head>
