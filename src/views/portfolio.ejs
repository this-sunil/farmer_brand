<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sunil Shedge — Senior Flutter Developer</title>
<meta name="description" content="Sunil Shedge, Senior Flutter Developer based in Pune, India. 4+ years building cross-platform mobile apps with Flutter, Dart, Node.js and PostgreSQL." />
<link rel="icon" href="https://avatars.githubusercontent.com/u/51407211?s=400&v=4" />

<!-- Bootstrap 5.3.3 (latest) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<!-- AOS — Animate On Scroll -->
<link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#07080d; --surface:#12141f; --surface2:#171a28;
    --line:rgba(255,255,255,.08); --line-strong:rgba(255,255,255,.16);
    --text-dim:#9aa3b5; --text-faint:#5c6479;
    --violet:#8b6cf2; --violet-2:#c9a8ff; --cyan:#3fe0c5; --coral:#ff8a65;
    --grad-1:linear-gradient(120deg,#8b6cf2 0%,#3fe0c5 100%);
    --grad-2:linear-gradient(135deg,#ff8a65 0%,#8b6cf2 100%);
    --font-display:'Sora',sans-serif; --font-body:'Inter',sans-serif; --font-mono:'JetBrains Mono',monospace;
  }
  *{scrollbar-color:var(--violet) transparent;}
  ::-webkit-scrollbar{width:10px;}
  ::-webkit-scrollbar-track{background:var(--bg);}
  ::-webkit-scrollbar-thumb{background:var(--surface2); border-radius:10px;}
  ::selection{background:var(--violet); color:#fff;}
  html{scroll-behavior:smooth;}
  body{margin:0; background:var(--bg); color:#f2f4f8; font-family:var(--font-body); -webkit-font-smoothing:antialiased; overflow-x:hidden;}
  h1,h2,h3,h4,.navbar-brand{font-family:var(--font-display);}
  a{text-decoration:none; color:inherit;}
  section{padding:120px 0; position:relative;}
  .container{position:relative; z-index:2;}

  /* preloader */
  #preloader{
    position:fixed; inset:0; z-index:9999; background:var(--bg); display:flex; align-items:center; justify-content:center;
    transition:opacity .5s ease, visibility .5s ease;
  }
  #preloader.hide{opacity:0; visibility:hidden;}
  .loader-ring{
    width:46px; height:46px; border-radius:50%; border:3px solid var(--line); border-top-color:var(--cyan);
    animation:spin .9s linear infinite;
  }
  @keyframes spin{to{transform:rotate(360deg);}}

  /* background layers */
  .bg-mesh{position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;}
  .bg-mesh span{position:absolute; border-radius:50%; filter:blur(110px); opacity:.32; animation:drift 18s ease-in-out infinite;}
  .bg-mesh .m1{width:520px; height:520px; background:var(--violet); top:-140px; left:-120px;}
  .bg-mesh .m2{width:460px; height:460px; background:var(--cyan); top:20%; right:-160px; opacity:.2; animation-delay:-6s;}
  .bg-mesh .m3{width:420px; height:420px; background:var(--coral); bottom:5%; left:10%; opacity:.15; animation-delay:-12s;}
  @keyframes drift{0%,100%{transform:translate(0,0);} 33%{transform:translate(30px,-40px);} 66%{transform:translate(-25px,25px);}}
  .bg-grid{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 10%,transparent 75%);
    -webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 10%,transparent 75%);
  }

  /* progress bar */
  #scrollProgress{position:fixed; top:0; left:0; height:3px; background:var(--grad-1); z-index:1001; width:0%; transition:width .1s linear;}

  /* navbar */
  .navbar{background:rgba(10,11,17,.65) !important; backdrop-filter:blur(18px) saturate(140%); border-bottom:1px solid var(--line); padding:14px 0; transition:.3s ease;}
  .navbar.scrolled{background:rgba(10,11,17,.92) !important; padding:10px 0;}
  .navbar-brand{font-weight:700; font-size:1.05rem; color:#fff !important; display:flex; align-items:center; gap:9px;}
  .brand-mark{width:32px; height:32px; border-radius:9px; background:var(--grad-1); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:.85rem; color:#0a0b10;}
  .nav-link{color:var(--text-dim) !important; font-weight:500; font-size:.88rem; padding:.55rem 1rem !important; position:relative; transition:.2s ease;}
  .nav-link::after{content:''; position:absolute; left:1rem; right:1rem; bottom:2px; height:1px; background:var(--grad-1); transform:scaleX(0); transition:transform .25s ease; transform-origin:left;}
  .nav-link:hover{color:#fff !important;}
  .nav-link:hover::after,.nav-link.active::after{transform:scaleX(1);}
  .nav-link.active{color:#fff !important;}
  .nav-cta{background:var(--grad-1); color:#0a0b10 !important; border-radius:999px; font-weight:600; padding:.6rem 1.3rem !important; margin-left:6px;}
  .nav-cta::after{display:none;}
  .nav-cta:hover{filter:brightness(1.1); transform:translateY(-1px);}

  .glass{background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.015)); border:1px solid var(--line); border-radius:20px; backdrop-filter:blur(20px);}
  .glass-hover{transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease;}
  .glass-hover:hover{transform:translateY(-6px); border-color:var(--line-strong); box-shadow:0 24px 48px rgba(0,0,0,.35),0 0 0 1px rgba(139,108,242,.15);}

  /* hero */
  .hero{padding:180px 0 90px;}
  .kicker{display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:.76rem; color:var(--cyan); background:rgba(63,224,197,.08); border:1px solid rgba(63,224,197,.25); padding:7px 15px 7px 11px; border-radius:999px; margin-bottom:26px;}
  .kicker .pulse{width:7px; height:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 0 0 rgba(63,224,197,.6); animation:pulse 2s infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(63,224,197,.55);} 70%{box-shadow:0 0 0 10px rgba(63,224,197,0);} 100%{box-shadow:0 0 0 0 rgba(63,224,197,0);}}
  .hero h1{font-weight:800; font-size:clamp(2.5rem,6vw,4.1rem); line-height:1.06; letter-spacing:-.02em; margin-bottom:14px; min-height:2.2em;}
  .hero h1 .grad-text{background:var(--grad-1); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .typed-cursor{display:inline-block; width:3px; background:var(--cyan); margin-left:4px; animation:blink 1s step-end infinite; vertical-align:-2px;}
  @keyframes blink{50%{opacity:0;}}
  .hero .lead{color:var(--text-dim); font-size:1.1rem; max-width:56ch; line-height:1.75; margin-bottom:38px;}
  .btn-grad{background:var(--grad-1); border:none; color:#0a0b10; font-weight:700; padding:.85rem 1.7rem; border-radius:12px; position:relative; overflow:hidden; transition:transform .25s ease,box-shadow .25s ease; box-shadow:0 8px 24px rgba(139,108,242,.25);}
  .btn-grad:hover{transform:translateY(-3px); box-shadow:0 14px 32px rgba(139,108,242,.4); color:#0a0b10;}
  .btn-glass{border:1px solid var(--line-strong); color:#f2f4f8; padding:.85rem 1.7rem; border-radius:12px; background:rgba(255,255,255,.03); font-weight:600; transition:.25s ease;}
  .btn-glass:hover{background:rgba(255,255,255,.08); border-color:#fff; color:#fff; transform:translateY(-3px);}
  .hero-stats{display:flex; margin-top:60px; border-radius:18px; overflow:hidden;}
  .hero-stat{flex:1; padding:22px 20px; border-right:1px solid var(--line);}
  .hero-stat:last-child{border-right:none;}
  .hero-stat b{display:block; font-family:var(--font-display); font-size:2rem; font-weight:800; background:var(--grad-1); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .hero-stat span{font-family:var(--font-mono); font-size:.68rem; color:var(--text-faint); text-transform:uppercase; letter-spacing:.06em;}
  .hero-photo-wrap{position:relative; display:flex; justify-content:center;}
  .hero-photo-ring{width:300px; height:300px; border-radius:32px; padding:3px; background:var(--grad-1); box-shadow:0 30px 70px rgba(139,108,242,.35); animation:ringpulse 4s ease-in-out infinite;}
  @keyframes ringpulse{0%,100%{box-shadow:0 30px 70px rgba(139,108,242,.35);} 50%{box-shadow:0 30px 90px rgba(63,224,197,.4);}}
  .hero-photo-ring img{width:100%; height:100%; object-fit:cover; border-radius:29px; display:block; background:var(--surface2);}
  .float-badge{position:absolute; padding:10px 16px; border-radius:14px; font-family:var(--font-mono); font-size:.76rem; font-weight:600; display:flex; align-items:center; gap:8px; animation:float 5s ease-in-out infinite;}
  .float-badge.b1{top:-4%; right:-8%;}
  .float-badge.b2{bottom:6%; left:-14%; animation-delay:1.2s;}
  @keyframes float{0%,100%{transform:translateY(0);} 50%{transform:translateY(-12px);}}

  .section-tag{font-family:var(--font-mono); font-size:.76rem; letter-spacing:.14em; text-transform:uppercase; color:var(--cyan); display:flex; align-items:center; gap:10px; margin-bottom:14px;}
  .section-tag .num{color:var(--text-faint);}
  .section-title{font-weight:800; font-size:clamp(1.8rem,3.6vw,2.5rem); letter-spacing:-.01em; margin-bottom:16px;}
  .section-desc{color:var(--text-dim); max-width:60ch; margin-bottom:56px; font-size:1rem; line-height:1.7;}

  .about-card{padding:30px 26px;}
  .about-icon{width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center; background:var(--grad-1); font-size:1.3rem; color:#0a0b10; margin-bottom:20px; transition:transform .3s ease;}
  .about-card:hover .about-icon{transform:rotate(-8deg) scale(1.08);}
  .about-card h5{font-weight:700; margin-bottom:10px; font-size:1.05rem;}
  .about-card p{color:var(--text-dim); font-size:.9rem; line-height:1.65; margin:0;}

  .timeline{position:relative; padding-left:44px;}
  .timeline::before{content:''; position:absolute; left:14px; top:8px; bottom:8px; width:2px; background:linear-gradient(180deg,var(--violet),var(--cyan),transparent);}
  .tl-item{position:relative; margin-bottom:28px;}
  .tl-dot{position:absolute; left:-44px; top:26px; width:30px; height:30px; border-radius:50%; background:var(--surface2); border:2px solid var(--violet); display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-size:.62rem; font-weight:700; color:var(--violet-2); z-index:2;}
  .tl-item:first-child .tl-dot{background:var(--grad-1); border-color:transparent; color:#0a0b10;}
  .tl-card{padding:26px 28px; cursor:pointer;}
  .tl-head{display:flex; justify-content:space-between; align-items:flex-start; gap:14px; flex-wrap:wrap;}
  .tl-role{font-weight:700; font-size:1.08rem; margin:0;}
  .tl-org{color:var(--text-dim); font-family:var(--font-mono); font-size:.78rem; margin-top:4px;}
  .tl-date{font-family:var(--font-mono); font-size:.72rem; color:var(--cyan); background:rgba(63,224,197,.08); border:1px solid rgba(63,224,197,.25); padding:6px 12px; border-radius:999px; white-space:nowrap;}
  .tl-chevron{transition:transform .3s ease; color:var(--text-faint); font-size:1.1rem;}
  .tl-item.open .tl-chevron{transform:rotate(180deg); color:var(--cyan);}
  .tl-body{max-height:0; overflow:hidden; transition:max-height .4s ease;}
  .tl-item.open .tl-body{max-height:700px;}
  .tl-body-inner{padding-top:20px; margin-top:20px; border-top:1px solid var(--line);}
  .tl-body-inner ul{margin:0; padding-left:0; list-style:none;}
  .tl-body-inner li{position:relative; padding-left:22px; margin-bottom:12px; color:var(--text-dim); font-size:.91rem; line-height:1.65;}
  .tl-body-inner li::before{content:'▹'; position:absolute; left:0; color:var(--violet-2);}
  .tl-body-inner li b{color:#f2f4f8; font-weight:600;}
  .badge-metric{background:rgba(63,224,197,.12); color:var(--cyan); font-family:var(--font-mono); font-weight:600; border:1px solid rgba(63,224,197,.3);}
  .src-link{font-family:var(--font-mono); font-size:.76rem; color:var(--violet-2); border-bottom:1px dashed var(--violet-2); display:inline-block; margin-top:6px;}

  .skill-card{padding:28px; height:100%;}
  .skill-card h5{font-weight:700; margin-bottom:20px; display:flex; align-items:center; gap:12px; font-size:1rem;}
  .skill-card h5 .ic{width:38px; height:38px; border-radius:10px; background:rgba(139,108,242,.12); color:var(--violet-2); display:flex; align-items:center; justify-content:center; font-size:1.05rem; flex:0 0 auto;}
  .skill-tag{display:inline-flex; align-items:center; font-family:var(--font-mono); font-size:.76rem; padding:7px 13px; background:rgba(255,255,255,.04); border:1px solid var(--line); border-radius:8px; margin:0 7px 8px 0; color:var(--text-dim); transition:.2s ease;}
  .skill-tag:hover{border-color:var(--violet); color:#fff; background:rgba(139,108,242,.1); transform:translateY(-2px);}

  .proj-card{overflow:hidden; height:100%; display:flex; flex-direction:column;}
  .proj-top{height:132px; position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden;}
  .proj-top .grad-bg{position:absolute; inset:0; opacity:.9; transition:transform .4s ease;}
  .proj-card:hover .proj-top .grad-bg{transform:scale(1.15) rotate(4deg);}
  .proj-top i{position:relative; font-size:2.4rem; color:rgba(255,255,255,.9); z-index:1; transition:transform .3s ease;}
  .proj-card:hover .proj-top i{transform:scale(1.15);}
  .proj-body{padding:24px; flex:1; display:flex; flex-direction:column;}
  .proj-body h5{font-weight:700; margin-bottom:10px; font-size:1.05rem;}
  .proj-body p{color:var(--text-dim); font-size:.88rem; line-height:1.6; flex:1;}
  .tech-chip{font-size:.68rem; font-family:var(--font-mono); background:rgba(255,255,255,.04); border:1px solid var(--line); color:var(--text-dim); border-radius:6px; padding:4px 9px; margin:0 5px 5px 0; display:inline-block;}
  .proj-link{display:inline-flex; align-items:center; gap:8px; font-family:var(--font-mono); font-size:.78rem; font-weight:600; color:var(--cyan); margin-top:16px;}
  .proj-link i{transition:transform .2s ease;}
  .proj-card:hover .proj-link i{transform:translateX(4px);}

  .edu-row{display:flex; gap:22px; align-items:center; padding:22px 26px; transition:background .2s ease;}
  .edu-row:hover{background:rgba(255,255,255,.02);}
  .edu-badge{flex:0 0 auto; width:58px; height:58px; border-radius:14px; background:var(--grad-2); display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:800; font-size:.78rem; color:#0a0b10;}
  .edu-row h6{font-weight:700; margin-bottom:3px; font-size:.98rem;}
  .edu-row .inst{color:var(--text-dim); font-size:.86rem;}
  .edu-row .date{font-family:var(--font-mono); font-size:.76rem; color:var(--text-faint); margin-left:auto; white-space:nowrap;}

  .footer-cta{padding:64px 50px; position:relative; overflow:hidden; text-align:center;}
  .footer-cta::before{content:''; position:absolute; inset:0; background:radial-gradient(ellipse 60% 80% at 50% -10%,rgba(139,108,242,.25),transparent 70%);}
  .footer-cta h2{font-weight:800; font-size:clamp(1.8rem,4vw,2.8rem); margin-bottom:16px; position:relative;}
  .footer-cta p{color:var(--text-dim); max-width:52ch; margin:0 auto 36px; font-size:1.02rem; position:relative;}
  .footer-links{display:flex; flex-wrap:wrap; gap:14px; justify-content:center; position:relative;}
  .footer-links a{font-family:var(--font-mono); font-size:.82rem; font-weight:600; padding:12px 20px; border-radius:12px; border:1px solid var(--line-strong); background:rgba(255,255,255,.03); display:inline-flex; gap:9px; align-items:center; transition:.25s ease;}
  .footer-links a:hover{background:var(--grad-1); color:#0a0b10; border-color:transparent; transform:translateY(-3px);}
  .site-footer{padding:36px 0; text-align:center; font-family:var(--font-mono); font-size:.74rem; color:var(--text-faint); border-top:1px solid var(--line);}

  #backToTop{position:fixed; bottom:26px; right:26px; width:46px; height:46px; border-radius:50%; background:var(--grad-1); color:#0a0b10; display:flex; align-items:center; justify-content:center; font-size:1.1rem; z-index:900; opacity:0; visibility:hidden; transform:translateY(10px); transition:.3s ease; border:none;}
  #backToTop.show{opacity:1; visibility:visible; transform:translateY(0);}
  #backToTop:hover{transform:translateY(-4px);}

  @media (max-width:991px){
    .hero{padding:140px 0 60px;}
    .hero-stats{flex-wrap:wrap;}
    .hero-stat{flex:1 1 45%; border-right:1px solid var(--line); border-bottom:1px solid var(--line);}
  }
</style>
</head>
<body>

<div id="preloader"><div class="loader-ring"></div></div>
<div id="scrollProgress"></div>

<div class="bg-grid"></div>
<div class="bg-mesh"><span class="m1"></span><span class="m2"></span><span class="m3"></span></div>

<nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
  <div class="container">
    <a class="navbar-brand" href="#top"><span class="brand-mark">SS</span>Sunil Shedge</a>
    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <i class="bi bi-list fs-2 text-white"></i>
    </button>
    <div class="collapse navbar-collapse justify-content-end" id="navMenu">
      <ul class="navbar-nav align-items-lg-center gap-lg-1">
        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="#experience">Experience</a></li>
        <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
