<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Sunil Shedge — Senior Flutter Developer with 4+ years of experience building scalable production-ready Flutter applications, backend systems, APIs, cloud integrations and CI/CD pipelines."
    />

    <meta
      name="keywords"
      content="Sunil Shedge, Flutter Developer, Senior Flutter Developer, Flutter, Dart, Firebase, Node.js, PostgreSQL, Pune, Android, iOS, Web"
    />

    <meta name="author" content="Sunil Shedge" />

    <title>Sunil Shedge | Senior Flutter Developer</title>

    <link
      rel="icon"
      href="https://avatars.githubusercontent.com/u/51407211?s=400&u=751977b12a298feec"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      /* =========================================================
   ROOT / DESIGN SYSTEM
========================================================= */

      :root {
        --bg: #f4f7f5;
        --white: #ffffff;

        --black: #07110d;
        --black-2: #0d1914;

        --ink: #122019;
        --text: #34423b;
        --muted: #68766f;
        --light-text: #91a099;

        --green: #16a36b;
        --green-dark: #08764d;
        --green-light: #e7f8ef;
        --green-border: #bcebd3;

        --lime: #b8df55;
        --blue: #3b82f6;
        --purple: #8b5cf6;
        --orange: #f59e0b;
        --red: #ef4444;

        --border: #dfe8e3;
        --border-light: #edf2ef;

        --radius: 20px;

        --shadow: 0 20px 60px rgba(7, 17, 13, 0.07);
        --shadow-small: 0 8px 30px rgba(7, 17, 13, 0.06);

        --font-body: "DM Sans", sans-serif;
        --font-heading: "Manrope", sans-serif;

        /* Preview */
        --preview-bg: #f4f7f5;
        --preview-surface: #ffffff;
        --preview-soft: #f8faf9;
        --preview-text: #102019;
        --preview-text-soft: #52625a;
        --preview-muted: #7b8982;
        --preview-border: #e4ebe7;

        --preview-primary: #19b86b;
        --preview-primary-dark: #07864b;
        --preview-primary-soft: #e8f8ef;

        --preview-shadow-sm: 0 8px 25px rgba(16, 32, 25, 0.06);
        --preview-shadow-lg: 0 25px 70px rgba(16, 32, 25, 0.12);

        --preview-radius-lg: 24px;
        --preview-radius-md: 18px;
      }

      /* =========================================================
   RESET
========================================================= */

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 100px;
        font-size: 16px;
      }

      body {
        background: var(--bg);
        color: var(--text);

        font-family: var(--font-body);
        font-size: 15px;
        line-height: 1.65;

        overflow-x: hidden;

        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body.menu-open {
        overflow: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      textarea,
      select {
        font-family: inherit;
      }

      button {
        cursor: pointer;
      }

      img {
        display: block;
        max-width: 100%;
      }

      ::selection {
        background: var(--green);
        color: #ffffff;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: var(--font-heading);
        color: var(--ink);
      }

      p {
        margin: 0;
      }

      /* =========================================================
   GLOBAL CONTAINER
========================================================= */

      .container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      /* =========================================================
   NAVBAR
========================================================= */

      .navbar {
        position: fixed;

        top: 18px;
        left: 50%;

        z-index: 1000;

        transform: translateX(-50%);

        width: min(1160px, calc(100% - 30px));

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 11px 12px 11px 18px;

        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;

        background: rgba(8, 19, 14, 0.88);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.16);

        transition:
          background 0.25s ease,
          box-shadow 0.25s ease;
      }

      /* Brand */

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #ffffff;

        font-size: 15px;
        font-weight: 800;

        white-space: nowrap;
      }

      .brand-mark {
        width: 34px;
        height: 34px;

        display: grid;
        place-items: center;

        border-radius: 10px;

        background: linear-gradient(135deg, var(--green), var(--lime));

        color: #07110d;

        font-size: 14px;
        font-weight: 900;
      }

      /* Navigation */

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .nav-links a {
        padding: 9px 12px;

        border-radius: 9px;

        color: #b8c6c0;

        font-size: 14px;
        font-weight: 700;

        transition:
          color 0.25s ease,
          background 0.25s ease;
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: #ffffff;

        background: rgba(255, 255, 255, 0.08);
      }

      .nav-contact {
        display: inline-flex !important;

        align-items: center;
        justify-content: center;

        gap: 6px;

        color: #07110d !important;

        background: var(--lime) !important;
      }

      .nav-contact:hover {
        background: #c8ed6a !important;
      }

      /* Mobile menu */

      .menu-button {
        display: none;

        width: 40px;
        height: 40px;

        border: 0;
        border-radius: 10px;

        background: rgba(255, 255, 255, 0.08);

        color: #ffffff;

        font-size: 17px;
      }

      /* =========================================================
   HERO
========================================================= */

      .hero {
        position: relative;

        min-height: 780px;

        padding: 170px 0 100px;

        overflow: hidden;

        background:
          radial-gradient(
            circle at 75% 20%,
            rgba(22, 163, 107, 0.23),
            transparent 25%
          ),
          radial-gradient(
            circle at 10% 85%,
            rgba(184, 223, 85, 0.08),
            transparent 25%
          ),
          linear-gradient(135deg, #06100c, #0b1c15 55%, #10271d);

        color: #ffffff;
      }

      .hero-grid {
        position: relative;

        z-index: 2;

        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          340px;

        gap: 70px;

        align-items: center;
      }

      /* Hero kicker */

      .hero-kicker {
        display: inline-flex;
        align-items: center;

        gap: 8px;

        padding: 8px 12px;

        border: 1px solid rgba(255, 255, 255, 0.12);

        border-radius: 999px;

        background: rgba(255, 255, 255, 0.05);

        color: #9ff0c8;

        font-size: 11px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: 1.2px;
      }

      .status-dot {
        width: 7px;
        height: 7px;

        flex: 0 0 auto;

        border-radius: 50%;

        background: #36d399;

        box-shadow: 0 0 0 5px rgba(54, 211, 153, 0.1);
      }

      /* Hero heading */

      .hero h1 {
        max-width: 850px;

        margin-top: 24px;

        color: #ffffff;

        font-size: clamp(48px, 6.5vw, 82px);

        line-height: 0.98;

        letter-spacing: -3.5px;

        font-weight: 800;
      }

      .hero h1 span {
        color: var(--lime);
      }

      /* Hero title */

      .hero-title {
        max-width: 820px;

        margin-top: 24px;

        color: #b7f1d4;

        font-size: 17px;

        font-weight: 800;

        line-height: 1.65;
      }

      /* Hero description */

      .hero-description {
        max-width: 760px;

        margin-top: 18px;

        color: #aebbb5;

        font-size: 15px;

        line-height: 1.8;
      }

      /* Hero actions */

      .hero-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 10px;

        margin-top: 30px;
      }

      .button {
        min-height: 46px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 0 17px;

        border-radius: 10px;

        font-size: 14px;

        font-weight: 800;

        transition:
          transform 0.25s ease,
          background 0.25s ease;
      }

      .button-primary {
        background: var(--lime);

        color: #07110d;
      }

      .button-primary:hover {
        transform: translateY(-2px);

        background: #c8ed6a;
      }

      .button-secondary {
        border: 1px solid rgba(255, 255, 255, 0.14);

        background: rgba(255, 255, 255, 0.06);

        color: #ffffff;
      }

      .button-secondary:hover {
        transform: translateY(-2px);

        background: rgba(255, 255, 255, 0.1);
      }

      /* Hero links */

      .hero-links {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 28px;
      }

      .hero-link {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding: 8px 11px;

        border: 1px solid rgba(255, 255, 255, 0.08);

        border-radius: 8px;

        color: #aebbb5;

        font-size: 11px;

        font-weight: 600;

        transition:
          color 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .hero-link:hover {
        color: #ffffff;

        border-color: rgba(184, 223, 85, 0.35);

        background: rgba(255, 255, 255, 0.05);
      }

      /* =========================================================
   HERO PROFILE CARD
========================================================= */

      .profile-card {
        position: relative;

        padding: 24px;

        border: 1px solid rgba(255, 255, 255, 0.12);

        border-radius: 24px;

        background: rgba(255, 255, 255, 0.055);

        backdrop-filter: blur(20px);

        -webkit-backdrop-filter: blur(20px);

        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
      }

      .profile-top {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;
      }

      .profile-avatar {
        width: 75px;
        height: 75px;

        display: grid;

        place-items: center;

        border: 3px solid rgba(184, 223, 85, 0.35);

        border-radius: 22px;

        background: linear-gradient(135deg, #183c2b, #10251c);

        color: var(--lime);

        font-family: var(--font-heading);

        font-size: 27px;

        font-weight: 800;
      }

      .profile-badge {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding: 7px 9px;

        border-radius: 999px;

        background: rgba(54, 211, 153, 0.1);

        color: #73e4b0;

        font-size: 10px;

        font-weight: 800;
      }

      .profile-name {
        margin-top: 22px;

        color: #ffffff;

        font-size: 20px;

        font-weight: 800;
      }

      .profile-role {
        margin-top: 4px;

        color: #91a099;

        font-size: 12px;
      }

      .profile-divider {
        height: 1px;

        margin: 22px 0;

        background: rgba(255, 255, 255, 0.09);
      }

      .profile-item {
        display: flex;

        align-items: center;

        gap: 5px;

        margin-top: 5px;

        color: #aebbb5;

        font-size: 12px;
      }

      .profile-item i {
        width: 18px;

        flex: 0 0 auto;

        color: var(--lime);
      }

      .profile-stack {
        display: flex;

        flex-wrap: wrap;

        gap: 5px;

        margin-top: 10px;
      }

      .profile-stack span {
        padding: 6px 8px;

        border: 1px solid rgba(255, 255, 255, 0.09);

        border-radius: 6px;

        color: #b7c2bd;

        background: rgba(255, 255, 255, 0.04);

        font-size: 10px;

        font-weight: 700;
      }

      /* =========================================================
   METRICS
========================================================= */

      .metrics {
        position: relative;

        z-index: 5;

        margin-top: -65px;
      }

      .metrics-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        border: 1px solid var(--border);

        border-radius: 18px;

        background: #ffffff;

        box-shadow: var(--shadow);
      }

      .metric {
        position: relative;

        padding: 27px 25px;
      }

      .metric:not(:last-child)::after {
        content: "";

        position: absolute;

        top: 25px;
        right: 0;
        bottom: 25px;

        width: 1px;

        background: var(--border-light);
      }

      .metric-number {
        color: var(--ink);

        font-family: var(--font-heading);

        font-size: 32px;

        line-height: 1.1;

        font-weight: 800;

        letter-spacing: -1px;
      }

      .metric-label {
        margin-top: 6px;

        color: var(--muted);

        font-size: 11px;

        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: 0.5px;
      }

      .metric-description {
        margin-top: 9px;

        color: #849189;

        font-size: 11px;

        line-height: 1.55;
      }

      /* =========================================================
   MAIN
========================================================= */

      main {
        padding: 100px 0;
      }

      .section {
        margin-bottom: 110px;
      }

      .section:last-child {
        margin-bottom: 0;
      }

      /* =========================================================
   SECTION HEADER
========================================================= */

      .section-header {
        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 25px;

        margin-bottom: 35px;
      }

      .section-kicker {
        color: var(--green);

        font-size: 10px;

        font-weight: 900;

        text-transform: uppercase;

        letter-spacing: 1.8px;
      }

      .section-title {
        margin-top: 7px;

        color: var(--ink);

        font-size: clamp(28px, 4vw, 40px);

        line-height: 1.1;

        letter-spacing: -1.4px;

        font-weight: 800;
      }

      .section-description {
        max-width: 570px;

        color: var(--muted);

        font-size: 15px;

        line-height: 1.75;
      }

      /* =========================================================
   ABOUT
========================================================= */

      .about-grid {
        display: grid;

        grid-template-columns: 1.35fr 0.65fr;

        gap: 20px;
      }

      .about-card {
        padding: 29px;

        border: 1px solid var(--border);

        border-radius: var(--radius);

        background: #ffffff;

        box-shadow: var(--shadow-small);
      }

      .about-card p {
        color: var(--text);

        font-size: 15px;

        line-height: 1.85;
      }

      .about-card p + p {
        margin-top: 14px;
      }

      .about-card strong {
        color: var(--ink);
      }

      .highlight {
        color: var(--green);

        font-weight: 800;
      }

      /* Focus list */

      .focus-list {
        display: grid;

        gap: 9px;
      }

      .focus-item {
        display: flex;

        align-items: center;

        gap: 10px;

        padding: 12px;

        border: 1px solid var(--border-light);

        border-radius: 10px;

        background: #f9fbfa;

        color: var(--text);

        font-size: 12px;

        font-weight: 700;
      }

      .focus-icon {
        width: 29px;
        height: 29px;

        display: grid;

        place-items: center;

        flex: 0 0 auto;

        border-radius: 8px;

        background: var(--green-light);

        color: var(--green);
      }

      /* =========================================================
   SKILLS
========================================================= */

      .skills-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 13px;
      }

      .skill-card {
        padding: 20px;

        border: 1px solid var(--border);

        border-radius: 15px;

        background: #ffffff;

        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .skill-card:hover {
        transform: translateY(-4px);

        border-color: var(--green-border);

        box-shadow: var(--shadow-small);
      }

      .skill-header {
        display: flex;

        align-items: center;

        gap: 11px;
      }

      .skill-icon {
        width: 35px;
        height: 35px;

        display: grid;

        place-items: center;

        border-radius: 10px;

        background: var(--green-light);

        color: var(--green);

        font-size: 15px;
      }

      .skill-name {
        color: var(--ink);

        font-size: 13px;

        font-weight: 800;
      }

      .skill-tags {
        display: flex;

        flex-wrap: wrap;

        gap: 6px;

        margin-top: 14px;
      }

      .tag {
        padding: 6px 9px;

        border: 1px solid var(--border);

        border-radius: 6px;

        background: #fafcfb;

        color: #58675f;

        font-size: 11px;

        font-weight: 700;
      }

      .tag.main {
        border-color: var(--green-border);

        background: var(--green-light);

        color: var(--green-dark);
      }

      /* =========================================================
   EXPERIENCE
========================================================= */

      .experience-layout {
        display: grid;

        grid-template-columns: 220px 1fr;

        gap: 45px;
      }

      .experience-company {
        position: sticky;

        top: 100px;

        height: fit-content;
      }

      .experience-label {
        color: var(--green);

        font-size: 10px;

        font-weight: 900;

        text-transform: uppercase;

        letter-spacing: 1px;
      }

      .experience-company h3 {
        margin-top: 8px;

        color: var(--ink);

        font-size: 21px;

        font-weight: 800;
      }

      .experience-company p {
        margin-top: 6px;

        color: var(--muted);

        font-size: 12px;
      }

      .timeline {
        position: relative;
      }

      .timeline::before {
        content: "";

        position: absolute;

        top: 7px;
        bottom: 5px;
        left: 7px;

        width: 1px;

        background: #d6e4dc;
      }

      .experience-item {
        position: relative;

        padding-left: 38px;

        margin-bottom: 48px;
      }

      .experience-item:last-child {
        margin-bottom: 0;
      }

      .experience-dot {
        position: absolute;

        top: 5px;
        left: 0;

        width: 15px;
        height: 15px;

        border: 4px solid var(--bg);

        border-radius: 50%;

        background: var(--green);

        box-shadow: 0 0 0 1px var(--green-border);
      }

      .experience-top {
        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 20px;
      }

      .experience-role {
        color: var(--ink);

        font-size: 18px;

        font-weight: 800;
      }

      .experience-company-name {
        margin-top: 3px;

        color: var(--green);

        font-size: 12px;

        font-weight: 800;
      }

      .experience-date {
        flex: 0 0 auto;

        padding: 7px 10px;

        border-radius: 7px;

        background: #fff6e6;

        color: #bd7600;

        font-size: 10px;

        font-weight: 900;
      }

      .experience-list {
        margin-top: 16px;

        padding-left: 18px;
      }

      .experience-list li {
        margin-bottom: 8px;

        color: var(--muted);

        font-size: 13px;

        line-height: 1.7;
      }

      .experience-list li::marker {
        color: var(--green);
      }

      .experience-list strong {
        color: var(--ink);
      }

      /* =========================================================
   PROJECT TOOLBAR
========================================================= */

      .project-toolbar {
        display: flex;

        flex-wrap: wrap;

        gap: 7px;

        margin-bottom: 30px;
      }

      .filter-button {
        padding: 9px 13px;

        border: 1px solid var(--border);

        border-radius: 8px;

        background: #ffffff;

        color: var(--muted);

        font-size: 11px;

        font-weight: 800;

        cursor: pointer;

        transition:
          color 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .filter-button:hover,
      .filter-button.active {
        border-color: var(--green);

        background: var(--green);

        color: #ffffff;
      }

      /* =========================================================
   PROJECTS
========================================================= */

      .projects {
        display: grid;

        gap: 20px;
      }

      .project-card {
        position: relative;

        overflow: hidden;

        border: 1px solid var(--border);

        border-radius: 22px;

        background: #ffffff;

        box-shadow: var(--shadow-small);

        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease,
          border-color 0.3s ease;
      }

      .project-card:hover {
        transform: translateY(-5px);

        border-color: var(--green-border);

        box-shadow: 0 25px 65px rgba(7, 17, 13, 0.1);
      }

      .project-card.featured {
        border-color: #bde8d0;
      }

      /* Project top */

      .project-top {
        display: grid;

        grid-template-columns: 180px 1fr;

        gap: 30px;

        padding: 27px;
      }

      .project-sidebar {
        height: fit-content;

        padding: 18px;

        border: 1px solid var(--border-light);

        border-radius: 15px;

        background: linear-gradient(145deg, #f0faf5, #f9fbfa);
      }

      .project-number {
        color: var(--green);

        font-size: 10px;

        font-weight: 900;

        letter-spacing: 1.4px;

        text-transform: uppercase;
      }

      .project-symbol {
        width: 50px;
        height: 50px;

        display: grid;

        place-items: center;

        margin-top: 12px;

        border: 1px solid var(--border);

        border-radius: 14px;

        background: #ffffff;

        color: var(--green);

        font-size: 21px;

        box-shadow: 0 8px 20px rgba(7, 17, 13, 0.04);
      }

      .project-category {
        margin-top: 14px;

        color: var(--muted);

        font-size: 10px;

        font-weight: 900;

        line-height: 1.5;

        text-transform: uppercase;

        letter-spacing: 0.6px;
      }

      .project-mini-tags {
        display: flex;

        flex-wrap: wrap;

        gap: 4px;

        margin-top: 11px;
      }

      .project-mini-tags span {
        padding: 5px 7px;

        border: 1px solid var(--border);

        border-radius: 5px;

        background: #ffffff;

        color: var(--muted);

        font-size: 9px;

        font-weight: 800;
      }

      .project-main {
        min-width: 0;
      }

      .project-title-row {
        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 20px;
      }

      .project-title {
        color: var(--ink);

        font-size: 25px;

        line-height: 1.2;

        letter-spacing: -0.7px;

        font-weight: 800;
      }

      .project-subtitle {
        margin-top: 6px;

        color: var(--green);

        font-size: 10px;

        font-weight: 900;

        text-transform: uppercase;

        letter-spacing: 1px;
      }

      .project-button {
        display: inline-flex;

        align-items: center;

        gap: 6px;

        flex: 0 0 auto;

        padding: 8px 11px;

        border: 1px solid var(--green-border);

        border-radius: 7px;

        background: var(--green-light);

        color: var(--green-dark);

        font-size: 10px;

        font-weight: 900;

        transition:
          color 0.2s ease,
          background 0.2s ease;
      }

      .project-button:hover {
        background: var(--green-dark);

        color: #ffffff;
      }

      /* Project description */

      .project-description {
        margin-top: 16px;

        color: var(--text);

        font-size: 14px;

        line-height: 1.8;
      }

      .project-description strong {
        color: var(--ink);
      }

      /* =========================================================
   PROJECT DETAILS
========================================================= */

      .project-detail-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 9px;

        margin-top: 20px;
      }

      .project-detail {
        padding: 14px;

        border: 1px solid var(--border-light);

        border-radius: 10px;

        background: #fafcfb;
      }

      .detail-title {
        display: flex;

        align-items: center;

        gap: 6px;

        color: var(--ink);

        font-size: 11px;

        font-weight: 900;
      }

      .detail-title i {
        color: var(--green);
      }

      .detail-text {
        margin-top: 6px;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.65;
      }

      /* =========================================================
   PROJECT FEATURES
========================================================= */

      .project-features {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 8px 20px;

        margin-top: 18px;

        list-style: none;
      }

      .project-features li {
        position: relative;

        padding-left: 15px;

        color: var(--muted);

        font-size: 12px;

        line-height: 1.7;
      }

      .project-features li::before {
        content: "";

        position: absolute;

        left: 0;
        top: 9px;

        width: 5px;
        height: 5px;

        border-radius: 50%;

        background: var(--green);
      }

      .project-features strong {
        color: var(--ink);
      }

      /* =========================================================
   PROJECT BOTTOM
========================================================= */

      .project-bottom {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-top: 21px;

        padding-top: 15px;

        border-top: 1px solid var(--border-light);
      }

      .project-tech {
        display: flex;

        flex-wrap: wrap;

        gap: 5px;
      }

      .technology {
        padding: 6px 8px;

        border: 1px solid var(--border);

        border-radius: 5px;

        background: #ffffff;

        color: #58675f;

        font-size: 10px;

        font-weight: 800;
      }

      .project-result {
        display: flex;

        align-items: center;

        gap: 5px;

        color: var(--green-dark);

        font-size: 10px;

        font-weight: 900;

        white-space: nowrap;
      }

      .project-result i {
        color: var(--green);
      }

      /* =========================================================
   GROW KNOWLEDGE
========================================================= */

      .grow-highlight {
        margin: 0 27px 27px;

        padding: 22px;

        border: 1px solid #c7ead7;

        border-radius: 16px;

        background:
          radial-gradient(
            circle at 100% 0%,
            rgba(22, 163, 107, 0.12),
            transparent 35%
          ),
          linear-gradient(135deg, #f0fbf5, #fbfdfc);
      }

      .grow-highlight-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;
      }

      .grow-label {
        color: var(--green);

        font-size: 10px;

        font-weight: 900;

        letter-spacing: 1.4px;

        text-transform: uppercase;
      }

      .grow-heading {
        margin-top: 5px;

        color: var(--ink);

        font-size: 17px;

        font-weight: 800;
      }

      .grow-stat {
        padding: 9px 12px;

        border: 1px solid var(--green-border);

        border-radius: 9px;

        background: #ffffff;

        color: var(--green-dark);

        font-size: 10px;

        font-weight: 900;
      }

      .grow-features {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 7px;

        margin-top: 16px;
      }

      .grow-feature {
        display: flex;

        align-items: center;

        gap: 7px;

        padding: 9px;

        border: 1px solid #e0eee7;

        border-radius: 7px;

        background: #ffffff;

        color: var(--text);

        font-size: 10px;

        font-weight: 700;
      }

      .grow-feature i {
        color: var(--green);
      }

      /* =========================================================
   EDUCATION
========================================================= */

      .education-grid {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 14px;
      }

      .education-card {
        padding: 22px;

        border: 1px solid var(--border);

        border-radius: 16px;

        background: #ffffff;

        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }

      .education-card:hover {
        transform: translateY(-3px);

        border-color: var(--green-border);

        box-shadow: var(--shadow-small);
      }

      .education-icon {
        width: 37px;
        height: 37px;

        display: grid;

        place-items: center;

        border-radius: 10px;

        background: var(--green-light);

        color: var(--green);
      }

      .degree {
        margin-top: 15px;

        color: var(--ink);

        font-size: 14px;

        font-weight: 800;
      }

      .institution {
        margin-top: 5px;

        color: var(--muted);

        font-size: 12px;
      }

      .education-meta {
        display: inline-flex;

        margin-top: 12px;

        padding: 6px 8px;

        border-radius: 6px;

        background: #f2f8f4;

        color: var(--green-dark);

        font-size: 10px;

        font-weight: 900;
      }

      /* =========================================================
   CERTIFICATE
========================================================= */

      .certificate-card {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 25px;

        padding: 25px;

        border: 1px solid var(--border);

        border-radius: 18px;

        background: #ffffff;

        box-shadow: var(--shadow-small);
      }

      .certificate-left {
        display: flex;

        align-items: center;

        gap: 15px;
      }

      .certificate-icon {
        width: 50px;
        height: 50px;

        display: grid;

        place-items: center;

        flex: 0 0 auto;

        border-radius: 13px;

        background: #fff5df;

        color: var(--orange);

        font-size: 20px;
      }

      .certificate-title {
        color: var(--ink);

        font-size: 14px;

        font-weight: 800;
      }

      .certificate-description {
        margin-top: 3px;

        color: var(--muted);

        font-size: 11px;
      }

      /* =========================================================
   CONTACT
========================================================= */

      .contact {
        position: relative;

        overflow: hidden;

        padding: 55px;

        border-radius: 25px;

        color: #ffffff;

        background:
          radial-gradient(
            circle at 90% 10%,
            rgba(184, 223, 85, 0.2),
            transparent 30%
          ),
          linear-gradient(135deg, #07120d, #0d271c);
      }

      .contact-grid {
        display: grid;

        grid-template-columns: 1fr auto;

        gap: 40px;

        align-items: center;
      }

      .contact-kicker {
        color: var(--lime);

        font-size: 10px;

        font-weight: 900;

        text-transform: uppercase;

        letter-spacing: 1.6px;
      }

      .contact h2 {
        margin-top: 10px;

        color: #ffffff;

        font-size: clamp(30px, 4vw, 44px);

        line-height: 1.1;

        letter-spacing: -1.4px;
      }

      .contact p {
        max-width: 620px;

        margin-top: 14px;

        color: #aebbb5;

        font-size: 14px;

        line-height: 1.75;
      }

      .contact-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 7px;

        margin-top: 22px;
      }

      .contact-action {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding: 10px 12px;

        border: 1px solid rgba(255, 255, 255, 0.1);

        border-radius: 8px;

        color: #c0cbc6;

        background: rgba(255, 255, 255, 0.05);

        font-size: 11px;

        font-weight: 700;
      }

      .contact-action:hover {
        color: #ffffff;

        border-color: rgba(184, 223, 85, 0.35);
      }

      .contact-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        padding: 13px 18px;

        border-radius: 10px;

        background: var(--lime);

        color: #07110d;

        font-size: 12px;

        font-weight: 900;

        white-space: nowrap;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .contact-button:hover {
        transform: translateY(-2px);

        background: #c8ed6a;
      }

      /* =========================================================
   FOOTER
========================================================= */

      footer {
        padding: 25px 0;

        border-top: 1px solid var(--border);

        background: #ffffff;
      }

      .footer-inner {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;
      }

      .footer-name {
        color: var(--ink);

        font-size: 11px;

        font-weight: 900;
      }

      .footer-text {
        color: var(--muted);

        font-size: 10px;
      }

      .footer-links {
        display: flex;

        gap: 7px;
      }

      .footer-links a {
        width: 30px;
        height: 30px;

        display: grid;

        place-items: center;

        border: 1px solid var(--border);

        border-radius: 8px;

        color: var(--muted);

        font-size: 12px;

        transition:
          color 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }

      .footer-links a:hover {
        border-color: var(--green-border);

        background: var(--green-light);

        color: var(--green);
      }

      /* =========================================================
   SCROLL REVEAL
========================================================= */

      .reveal {
        opacity: 0;

        transform: translateY(25px);

        transition:
          opacity 0.7s ease,
          transform 0.7s ease;
      }

      .reveal.visible {
        opacity: 1;

        transform: translateY(0);
      }

      /* =========================================================
   BACK TO TOP
========================================================= */

      .back-top {
        position: fixed;

        right: 20px;
        bottom: 20px;

        z-index: 900;

        width: 42px;
        height: 42px;

        display: grid;

        place-items: center;

        border: 1px solid var(--border);

        border-radius: 11px;

        background: #ffffff;

        color: var(--ink);

        font-size: 14px;

        box-shadow: var(--shadow-small);

        cursor: pointer;

        opacity: 0;

        pointer-events: none;

        transform: translateY(10px);

        transition:
          opacity 0.25s ease,
          transform 0.25s ease,
          color 0.25s ease,
          background 0.25s ease;
      }

      .back-top.show {
        opacity: 1;

        pointer-events: auto;

        transform: translateY(0);
      }

      .back-top:hover {
        color: #ffffff;

        background: var(--green);

        border-color: var(--green);
      }

      /* =========================================================
   WORK PREVIEW
========================================================= */

      #preview {
        position: relative;

        overflow: hidden;

        /*
    Reduced from 110px.
    Keeps the section more compact.
  */
        padding: 90px 0;

        background:
          radial-gradient(
            circle at 10% 10%,
            rgba(25, 184, 107, 0.1),
            transparent 28%
          ),
          radial-gradient(
            circle at 90% 20%,
            rgba(66, 133, 244, 0.08),
            transparent 25%
          ),
          var(--preview-bg);
      }

      /* =========================================================
   PREVIEW CONTAINER
========================================================= */

      #preview .preview-container {
        width: min(1380px, calc(100% - 48px));

        margin: 0 auto;
      }

      /* =========================================================
   PREVIEW HEADER
========================================================= */

      #preview .preview-header {
        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 40px;

        /*
    Reduced from 55px.
  */
        margin-bottom: 40px;
      }

      #preview .preview-eyebrow {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        padding: 8px 14px;

        margin-bottom: 15px;

        border: 1px solid rgba(25, 184, 107, 0.16);

        border-radius: 999px;

        background: var(--preview-primary-soft);

        color: var(--preview-primary-dark);

        font-size: 12px;

        font-weight: 800;

        letter-spacing: 0.08em;

        text-transform: uppercase;
      }

      #preview .preview-eyebrow i {
        font-size: 14px;
      }

      #preview .preview-title {
        max-width: 800px;

        margin: 0 0 15px;

        color: var(--preview-text);

        font-size: clamp(38px, 5vw, 68px);

        line-height: 1.02;

        letter-spacing: -0.045em;

        font-weight: 900;
      }

      #preview .preview-title span {
        color: var(--preview-primary);
      }

      #preview .preview-description {
        max-width: 760px;

        margin: 0;

        color: var(--preview-text-soft);

        font-size: 16px;

        line-height: 1.7;
      }

      /* =========================================================
   PROJECT COUNT
========================================================= */

      #preview .project-count {
        flex: 0 0 auto;

        display: flex;

        align-items: center;

        gap: 14px;

        padding: 16px 20px;

        border: 1px solid var(--preview-border);

        border-radius: var(--preview-radius-md);

        background: rgba(255, 255, 255, 0.88);

        box-shadow: var(--preview-shadow-sm);

        backdrop-filter: blur(12px);
      }

      #preview .project-count-icon {
        display: grid;

        place-items: center;

        width: 48px;
        height: 48px;

        border-radius: 14px;

        background: var(--preview-primary-soft);

        color: var(--preview-primary);

        font-size: 20px;
      }

      #preview .project-count strong {
        display: block;

        margin-bottom: 4px;

        color: var(--preview-text);

        font-size: 21px;

        line-height: 1;

        font-weight: 900;
      }

      #preview .project-count small {
        color: var(--preview-muted);

        font-size: 11px;

        font-weight: 600;
      }

      /* =========================================================
   PREVIEW PROJECT GRID
========================================================= */

      #preview .projects-grid {
        display: grid;

        grid-template-columns: repeat(3, minmax(0, 1fr));

        gap: 24px;

        /*
    Important:
    Prevent grid stretching from producing
    artificial equal-height cards.
  */
        align-items: start;
      }

      /* =========================================================
   PREVIEW PROJECT CARD
========================================================= */

      #preview .project-card {
        position: relative;

        display: flex;

        flex-direction: column;

        min-width: 0;

        /*
    Requested minimum height.
  */
        min-height: 350px;

        /*
    Do not force equal height.
  */
        height: auto;

        overflow: hidden;

        border: 1px solid var(--preview-border);

        border-radius: var(--preview-radius-lg);

        background: var(--preview-surface);

        box-shadow: var(--preview-shadow-sm);

        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease,
          border-color 0.3s ease;
      }

      #preview .project-card:hover {
        transform: translateY(-7px);

        border-color: rgba(25, 184, 107, 0.3);

        box-shadow: var(--preview-shadow-lg);
      }

      /* =========================================================
   PREVIEW PROJECT MEDIA
========================================================= */

      #preview .project-media {
        position: relative;

        width: 100%;

        /*
    Removed aspect-ratio: 16/9.
    Fixed height prevents unnecessarily tall cards.
  */
        height: 185px;

        min-height: 185px;

        overflow: hidden;

        background: #07110d;
      }

      #preview .project-media iframe,
      #preview .project-media video,
      #preview .project-media img {
        display: block;

        width: 100%;
        height: 100%;

        border: 0;

        object-fit: cover;
      }

      /* =========================================================
   PREVIEW PROJECT NUMBER
========================================================= */

      #preview .project-number {
        position: absolute;

        top: 13px;
        left: 13px;

        z-index: 2;

        padding: 6px 10px;

        border: 1px solid rgba(255, 255, 255, 0.22);

        border-radius: 999px;

        background: rgba(0, 0, 0, 0.62);

        color: #ffffff;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: 0.08em;

        backdrop-filter: blur(12px);
      }

      /* =========================================================
   PREVIEW PROJECT BODY
========================================================= */

      #preview .project-body {
        display: flex;

        flex-direction: column;

        /*
    Removed flex: 1.
    This prevents the body from stretching
    into unnecessary empty space.
  */
        flex: none;

        min-height: 165px;

        margin: 0;

        padding: 14px 16px 16px;

        gap: 0;
      }

      /* =========================================================
   PREVIEW PROJECT TOP
========================================================= */

      #preview .project-top {
        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 12px;

        margin: 0;

        padding: 0;
      }

      /* =========================================================
   PREVIEW CATEGORY
========================================================= */

      #preview .project-category {
        display: inline-flex;

        align-items: center;

        width: fit-content;

        padding: 6px 10px;

        margin: 0;

        border-radius: 999px;

        background: var(--preview-primary-soft);

        color: var(--preview-primary-dark);

        font-size: 9px;

        line-height: 1.2;

        font-weight: 800;

        letter-spacing: 0.08em;

        text-transform: uppercase;
      }

      /* =========================================================
   PREVIEW TITLE
========================================================= */

      #preview .project-title {
        margin: 9px 0 0;

        color: var(--preview-text);

        font-size: 19px;

        line-height: 1.2;

        letter-spacing: -0.025em;

        font-weight: 850;
      }

      /* =========================================================
   PREVIEW TYPE
========================================================= */

      #preview .project-type {
        flex: 0 0 auto;

        padding: 6px 10px;

        border-radius: 999px;

        background: #f2f5f3;

        color: var(--preview-text-soft);

        font-size: 10px;

        line-height: 1.2;

        font-weight: 800;

        white-space: nowrap;
      }

      /* =========================================================
   PREVIEW DESCRIPTION
========================================================= */

      #preview .project-description {
        margin: 7px 0 0;

        color: var(--preview-text-soft);

        font-size: 11px;

        line-height: 1.5;
      }

      /* =========================================================
   PREVIEW TECH STACK
========================================================= */

      #preview .tech-stack {
        display: flex;

        flex-wrap: wrap;

        gap: 5px;

        margin: 10px 0 0;

        padding: 0;
      }

      #preview .tech {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding: 5px 8px;

        border: 1px solid var(--preview-border);

        border-radius: 999px;

        background: #ffffff;

        color: #47564f;

        font-size: 9px;

        line-height: 1.2;

        font-weight: 700;

        transition:
          border-color 0.2s ease,
          transform 0.2s ease;
      }

      #preview .tech:hover {
        transform: translateY(-1px);

        border-color: rgba(25, 184, 107, 0.35);
      }

      #preview .tech-dot {
        width: 5px;
        height: 5px;

        flex: 0 0 auto;

        border-radius: 50%;

        background: var(--preview-primary);
      }

      /* =========================================================
   PREVIEW HIGHLIGHTS
========================================================= */

      #preview .highlights {
        /*
    THIS IS THE MAIN GAP FIX.

    Old:
      margin-top: auto;

    New:
      normal spacing.

    This prevents the highlights block from
    being pushed to the bottom of a stretched card.
  */
        margin: 12px 0 0;

        padding: 12px;

        border: 1px solid #e9eeeb;

        border-radius: 13px;

        background: var(--preview-soft);
      }

      #preview .highlight-header {
        display: flex;

        align-items: center;

        gap: 8px;

        margin: 0 0 9px;

        padding: 0;
      }

      #preview .highlight-icon {
        display: grid;

        place-items: center;

        width: 28px;
        height: 28px;

        flex: 0 0 auto;

        border-radius: 8px;

        background: var(--preview-text);

        color: #ffffff;

        font-size: 12px;
      }

      #preview .highlight-header strong {
        color: var(--preview-text);

        font-size: 11px;

        line-height: 1.2;

        font-weight: 800;
      }

      #preview .highlight-list {
        display: flex;

        flex-direction: column;

        gap: 5px;

        margin: 0;

        padding: 0;

        list-style: none;
      }

      #preview .highlight-list li {
        display: flex;

        align-items: flex-start;

        gap: 7px;

        margin: 0;

        padding: 0;

        color: var(--preview-text-soft);

        font-size: 10px;

        line-height: 1.4;
      }

      #preview .highlight-list i {
        flex: 0 0 auto;

        margin-top: 2px;

        color: var(--preview-primary);

        font-size: 11px;
      }

      /* =========================================================
   PREVIEW PROJECT ACCENTS
========================================================= */

      #preview .project-card:nth-child(2) .project-category {
        background: #eef1f5;

        color: #3d4b59;
      }

      #preview .project-card:nth-child(3) .project-category {
        background: #edf5ff;

        color: #3977c9;
      }

      #preview .project-card:nth-child(4) .project-category {
        background: #f1edff;

        color: #735bd0;
      }

      #preview .project-card:nth-child(5) .project-category {
        background: #fff4e7;

        color: #d47a21;
      }

      #preview .project-card:nth-child(6) .project-category {
        background: #fff0f2;

        color: #cf4757;
      }

      /* =========================================================
   PREVIEW CTA
========================================================= */

      #preview .preview-cta {
        position: relative;

        overflow: hidden;

        display: flex;

        align-items: center;

        justify-content: space-between;

