<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sunil Shedge | Senior Flutter Developer | 4+ Years Experience</title>

  <meta
    name="description"
    content="Sunil Shedge — Senior Flutter Developer with 4+ years of experience building production-ready Android, iOS and Web applications using Flutter, Dart, Node.js, PostgreSQL, Firebase, REST APIs, payments, maps, CI/CD and AI."
  >

  <meta name="author" content="Sunil Shedge">

  <link
    rel="icon"
    href="https://avatars.githubusercontent.com/u/51407211?s=400&v=4"
  >

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <style>

    :root {
      --bg: #07090d;
      --bg-soft: #0c1016;
      --card: #10151d;
      --card-2: #131a23;

      --border: #232d39;
      --border-light: #303c49;

      --text: #f5f7fa;
      --muted: #929eac;
      --muted-2: #6f7b88;

      --green: #b8f34a;
      --green-dark: #8fc72d;

      --cyan: #51dfcf;
      --purple: #9d83ff;
      --orange: #ffae69;
      --red: #ff6d7a;
      --blue: #5fa6ff;

      --container: 1240px;

      --radius: 22px;

      --shadow:
        0 30px 90px rgba(0, 0, 0, 0.45);

      --font-main:
        "DM Sans",
        sans-serif;

      --font-heading:
        "Space Grotesk",
        sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    html {
      scroll-padding-top: 100px;
    }

    body {
      background:
        radial-gradient(
          circle at 80% 0%,
          rgba(184, 243, 74, 0.08),
          transparent 25%
        ),
        radial-gradient(
          circle at 10% 20%,
          rgba(81, 223, 207, 0.07),
          transparent 25%
        ),
        var(--bg);

      color: var(--text);

      font-family: var(--font-main);

      line-height: 1.7;

      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    button {
      font-family: inherit;
    }

    .container {
      width: min(
        var(--container),
        calc(100% - 40px)
      );

      margin: auto;
    }

    /* =========================================================
       NAVBAR
    ========================================================= */

    .navbar {
      position: fixed;

      top: 14px;
      left: 50%;

      transform: translateX(-50%);

      width: min(
        1180px,
        calc(100% - 28px)
      );

      z-index: 9999;

      display: flex;
      align-items: center;

      padding: 10px 12px;

      border: 1px solid rgba(
        255,
        255,
        255,
        0.08
      );

      background: rgba(
        9,
        13,
        18,
        0.82
      );

      backdrop-filter: blur(20px);

      border-radius: 18px;
    }

    .logo {
      font-family: var(--font-heading);

      font-size: 1.15rem;

      font-weight: 700;

      letter-spacing: 0.08em;

      padding: 8px 10px;
    }

    .logo span {
      color: var(--green);
    }

    .nav-links {
      margin-left: auto;

      display: flex;

      align-items: center;

      gap: 4px;
    }

    .nav-links a {
      color: #aab5c2;

      font-size: 0.82rem;

      font-weight: 600;

      padding: 9px 11px;

      border-radius: 10px;

      transition: 0.25s;
    }

    .nav-links a:hover {
      color: white;

      background: #17202a;
    }

    .nav-links .hire-btn {
      color: #081006;

      background: var(--green);

      font-weight: 800;

      margin-left: 6px;
    }

    .mobile-menu {
      display: none;

      margin-left: auto;

      background: none;

      border: 0;

      color: white;

      font-size: 1.5rem;

      cursor: pointer;
    }

    /* =========================================================
       HERO
    ========================================================= */

    .hero {
      min-height: 100vh;

      display: grid;

      align-items: center;

      padding:
        150px
        0
        90px;
    }

    .hero-grid {
      display: grid;

      grid-template-columns:
        1.25fr
        0.75fr;

      gap: 70px;

      align-items: center;
    }

    .availability {
      display: inline-flex;

      align-items: center;

      gap: 9px;

      padding:
        7px
        12px;

      border-radius: 999px;

      border:
        1px solid
        rgba(
          184,
          243,
          74,
          0.25
        );

      background:
        rgba(
          184,
          243,
          74,
          0.07
        );

      color: #d9fca2;

      font-size: 0.77rem;

      font-weight: 700;
    }

    .status-dot {
      width: 8px;

      height: 8px;

      border-radius: 50%;

      background: var(--green);

      box-shadow:
        0 0 18px
        var(--green);
    }

    .hero h1 {
      margin:
        25px
        0
        16px;

      font-family:
        var(--font-heading);

      font-size:
        clamp(
          3.3rem,
          8vw,
          7.5rem
        );

      line-height: 0.9;

      letter-spacing: -0.075em;
    }

    .hero h1 span {
      color: var(--green);
    }

    .hero-role {
      font-size:
        clamp(
          1.1rem,
          2vw,
          1.55rem
        );

      font-weight: 700;

      color: #e3e9ef;
    }

    .hero-description {
      max-width: 780px;

      margin:
        23px
        0;

      color: var(--muted);

      font-size: 1.04rem;
    }

    .hero-tags {
      display: flex;

      flex-wrap: wrap;

      gap: 8px;
    }

    .hero-tag {
      padding:
        6px
        10px;

      border:
        1px solid
        var(--border);

      border-radius: 999px;

      background:
        rgba(
          255,
          255,
          255,
          0.025
        );

      color: #c1ccd7;

      font-size: 0.76rem;
    }

    .hero-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 11px;

      margin-top: 28px;
    }

    .btn {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      padding:
        12px
        16px;

      border-radius: 13px;

      border:
        1px solid
        var(--border);

      font-size: 0.84rem;

      font-weight: 800;

      transition:
        0.25s
        ease;
    }

    .btn:hover {
      transform:
        translateY(-3px);

      border-color:
        var(--border-light);
    }

    .btn-primary {
      color: #081006;

      background: var(--green);

      border-color: var(--green);
    }

    .btn-outline {
      background:
        rgba(
          255,
          255,
          255,
          0.025
        );
    }

    .profile-area {
      position: relative;

      display: flex;

      justify-content: center;
    }

    .profile-card {
      width:
        min(
          380px,
          100%
        );

      padding: 17px;

      border:
        1px solid
        #293644;

      background:
        linear-gradient(
          145deg,
          #141c25,
          #0a0f15
        );

      border-radius: 30px;

      box-shadow: var(--shadow);

      transform:
        rotate(2deg);
    }

    .profile-card img {
      width: 100%;

      aspect-ratio: 1;

      object-fit: cover;

      border-radius: 22px;
    }

    .floating-card {
      position: absolute;

      padding:
        10px
        13px;

      border:
        1px solid
        #2b3947;

      border-radius: 15px;

      background:
        rgba(
          14,
          21,
          29,
          0.94
        );

      box-shadow:
        0
        18px
        45px
        rgba(
          0,
          0,
          0,
          0.45
        );

      font-size: 0.78rem;

      font-weight: 800;
    }

    .floating-card.one {
      left: -25px;

      bottom: 45px;

      color: var(--cyan);
    }

    .floating-card.two {
      right: -15px;

      top: 45px;

      color: #cbbfff;
    }

    /* =========================================================
       SECTION
    ========================================================= */

    section {
      padding:
        105px
        0;
    }

    .section-heading {
      display: flex;

      justify-content: space-between;

      align-items: end;

      gap: 35px;

      margin-bottom: 38px;
    }

    .section-kicker {
      color: var(--green);

      font-size: 0.72rem;

      font-weight: 800;

      letter-spacing: 0.18em;

      text-transform: uppercase;
    }

    .section-heading h2 {
      margin-top: 9px;

      font-family:
        var(--font-heading);

      font-size:
        clamp(
          2rem,
          4vw,
          3.6rem
        );

      line-height: 1;

      letter-spacing: -0.045em;
    }

    .section-description {
      max-width: 650px;

      color: var(--muted);

      font-size: 0.94rem;
    }

    /* =========================================================
       STATS
    ========================================================= */

    .stats {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 14px;
    }

    .stat {
      padding: 22px;

      background:
        linear-gradient(
          145deg,
          #111821,
          #0c1117
        );

      border:
        1px solid
        var(--border);

      border-radius: 20px;
    }

    .stat strong {
      display: block;

      font-family:
        var(--font-heading);

      font-size: 2rem;

      color: white;
    }

    .stat span {
      color: var(--muted);

      font-size: 0.8rem;
    }

    /* =========================================================
       CARDS
    ========================================================= */

    .grid-2 {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 16px;

      margin-top: 16px;
    }

    .card {
      padding: 27px;

      background:
        linear-gradient(
          145deg,
          #111821,
          #0b1016
        );

      border:
        1px solid
        var(--border);

      border-radius:
        var(--radius);

      transition:
        transform
        0.3s
        ease,
        border-color
        0.3s
        ease;
    }

    .card:hover {
      transform:
        translateY(-4px);

      border-color:
        #354454;
    }

    .card h3 {
      margin-bottom: 9px;

      font-family:
        var(--font-heading);

      font-size: 1.18rem;
    }

    .card p {
      color: var(--muted);

      font-size: 0.9rem;
    }

    .card-icon {
      color: var(--green);

      font-size: 1.55rem;

      margin-bottom: 18px;
    }

    /* =========================================================
       EXPERIENCE
    ========================================================= */

    .timeline {
      position: relative;

      display: grid;

      gap: 17px;
    }

    .timeline::before {
      content: "";

      position: absolute;

      left: 17px;

      top: 18px;

      bottom: 18px;

      width: 1px;

      background:
        #2a3541;
    }

    .experience {
      position: relative;

      padding-left: 57px;
    }

    .experience::before {
      content: "";

      position: absolute;

      left: 11px;

      top: 29px;

      width: 13px;

      height: 13px;

      border-radius: 50%;

      background: var(--green);

      box-shadow:
        0
        0
        0
        6px
        rgba(
          184,
          243,
          74,
          0.10
        );
    }

    .experience-header {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 20px;
    }

    .experience-title {
      margin: 0 !important;

      font-size: 1.3rem !important;
    }

    .company {
      margin-top: 4px;

      color: var(--cyan);

      font-weight: 700;
    }

    .date {
      color: var(--muted-2);

      white-space: nowrap;

      font-size: 0.78rem;

      font-weight: 700;
    }

    .experience ul {
      margin-top: 18px;

      padding-left: 20px;

      color: var(--muted);

      font-size: 0.88rem;
    }

    .experience li {
      margin: 8px 0;
    }

    .highlight {
      color: var(--green);

      font-weight: 800;
    }

    /* =========================================================
       SKILLS
    ========================================================= */

    .skills-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 16px;
    }

    .skill-card h3 {
      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 16px;
    }

    .skill-card h3 small {
      color: var(--muted-2);

      font-size: 0.68rem;

      text-transform: uppercase;

      letter-spacing: 0.1em;
    }

    .skill-tags {
      display: flex;

      flex-wrap: wrap;

      gap: 8px;
    }

    .skill-tags span {
      padding:
        7px
        10px;

      background:
        #151d26;

      border:
        1px solid
        #283543;

      border-radius: 10px;

      color: #c5d0dc;

      font-size: 0.77rem;
    }

    /* =========================================================
       PROJECTS
    ========================================================= */

    .projects {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 17px;
    }

    .project {
      position: relative;

      overflow: hidden;

      min-height: 360px;
    }

    .project-number {
      color: #586575;

      font-family:
        var(--font-heading);

      font-size: 0.76rem;

      font-weight: 700;

      letter-spacing: 0.15em;
    }

    .project-type {
      display: inline-block;

      margin-top: 12px;

      padding:
        5px
        9px;

      border-radius: 999px;

      color: var(--green);

      background:
        rgba(
          184,
          243,
          74,
          0.07
        );

      border:
        1px solid
        rgba(
          184,
          243,
          74,
          0.16
        );

      font-size: 0.7rem;

      font-weight: 800;
    }

    .project h3 {
      margin:
        14px
        0
        8px;

      font-family:
        var(--font-heading);

      font-size: 1.5rem;
    }

    .project-description {
      color: var(--muted);

      font-size: 0.87rem;
    }

    .project-section {
      margin-top: 19px;
    }

    .project-section-title {
      color: #e8edf2;

      font-size: 0.73rem;

      font-weight: 800;

      text-transform: uppercase;

      letter-spacing: 0.09em;

      margin-bottom: 7px;
    }

    .project-features {
      display: flex;

      flex-wrap: wrap;

      gap: 7px;
    }

    .project-features span {
      padding:
        5px
        8px;

      color: #b8c4cf;

      background:
        #0a1016;

      border:
        1px solid
        #263441;

      border-radius: 8px;

      font-size: 0.7rem;
    }

    .project-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 22px;
    }

    .project-actions a {
      display: inline-flex;

      align-items: center;

      gap: 7px;

      padding:
        8px
        11px;

      border-radius: 10px;

      background: var(--green);

      color: #081006;

      font-size: 0.75rem;

      font-weight: 800;
    }

    .project-actions a.secondary {
      color: white;

      background:
        #17212b;

      border:
        1px solid
        #2a3947;
    }

    /* =========================================================
       VIDEO / WORK PREVIEW
    ========================================================= */

    .preview-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 17px;
    }

    .preview-card {
      overflow: hidden;

      padding: 0;
    }

    .preview-card iframe,
    .preview-card video {
      display: block;

      width: 100%;

      height: 260px;

      border: 0;

      background: black;
    }

    .preview-body {
      padding: 22px;
    }

    .preview-body h3 {
      font-family:
        var(--font-heading);

      font-size: 1.05rem;
    }

    .preview-body p {
      margin-top: 7px;

      color: var(--muted);

      font-size: 0.83rem;
    }

    /* =========================================================
       EDUCATION
    ========================================================= */

    .education-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 16px;
    }

    .education {
      display: flex;

      align-items: flex-start;

      gap: 15px;
    }

    .education-icon {
      min-width: 56px;

      height: 56px;

      display: grid;

      place-items: center;

      border-radius: 15px;

      color: var(--green);

      background:
        rgba(
          184,
          243,
          74,
          0.08
        );

      border:
        1px solid
        rgba(
          184,
          243,
          74,
          0.15
        );

      font-weight: 800;
    }

    .education h3 {
      margin: 0;

      font-size: 1rem;
    }

    .education p {
      margin-top: 4px;

      color: var(--muted);

      font-size: 0.82rem;
    }

    /* =========================================================
       CONTACT
    ========================================================= */

    .contact-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;
    }

    .contact-item {
      display: flex;

      align-items: center;

      gap: 14px;
    }

    .contact-icon {
      width: 43px;

      height: 43px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      color: var(--green);

      background:
        rgba(
          184,
          243,
          74,
          0.08
        );

      font-size: 1.2rem;
    }

    .contact-item small {
      display: block;

      color: var(--muted-2);

      font-size: 0.7rem;
    }

    .contact-item strong {
      font-size: 0.86rem;
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      border-top:
        1px solid
        var(--border);

      padding:
        30px
        0;

      color: var(--muted-2);

      font-size: 0.78rem;
    }

    .footer-inner {
      display: flex;

      justify-content: space-between;

      gap: 20px;
    }

    /* =========================================================
       ANIMATION
    ========================================================= */

    .reveal {
      opacity: 0;

      transform:
        translateY(25px);

      transition:
        opacity
        0.7s
        ease,
        transform
        0.7s
        ease;
    }

    .reveal.show {
      opacity: 1;

      transform: none;
    }

    .back-top {
      position: fixed;

      right: 22px;

      bottom: 22px;

      width: 44px;

      height: 44px;

      display: none;

      place-items: center;

      z-index: 999;

      border: 0;

      border-radius: 50%;

      color: #081006;

      background: var(--green);

      cursor: pointer;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1000px) {

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .profile-area {
        order: -1;
      }

      .profile-card {
        width: 300px;
      }

      .stats {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (max-width: 760px) {

      .container {
        width:
          calc(100% - 26px);
      }

      .navbar {
        top: 8px;
      }

      .mobile-menu {
        display: block;
      }

      .nav-links {
        display: none;

        position: absolute;

        top: 61px;

        left: 0;

        right: 0;

        flex-direction: column;

        padding: 10px;

        background:
          #0b1016;

        border:
          1px solid
          var(--border);

        border-radius: 15px;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        width: 100%;
      }

      .hero {
        padding-top: 110px;
      }

      .hero h1 {
        font-size: 4.3rem;
      }

      .grid-2,
      .skills-grid,
      .projects,
      .preview-grid,
      .education-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .section-heading {
        display: block;
      }

      .section-description {
        margin-top: 15px;
      }

      .experience-header {
        display: block;
      }

      .date {
        display: block;

        margin-top: 7px;
      }

      .floating-card {
        display: none;
      }

      .footer-inner {
        display: block;
      }

      .footer-inner span {
        display: block;

        margin: 5px 0;
      }

    }

    @media (max-width: 480px) {

      .stats {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 3.5rem;
      }

      .hero-actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

    }

    @media print {

      body {
        background: white;

        color: black;
      }

      .navbar,
      .back-top,
      .hero-actions {
        display: none !important;
      }

      .hero {
        min-height: auto;

        padding: 30px 0;
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .profile-area {
        display: none;
      }

      section {
        padding: 35px 0;
      }

      .card,
      .stat {
        background: white;

        border-color: #ddd;
      }

      .card p,
      .section-description,
      .experience ul {
        color: #333;
      }

      .reveal {
        opacity: 1;

        transform: none;
      }

    }

  </style>
</head>

<body>

<!-- =========================================================
     NAVIGATION
========================================================= -->

