<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Sunil Shedge — Senior Flutter Developer with 4+ years of experience building scalable production-ready Flutter applications, backend systems and cloud integrations."
  >

  <title>Sunil Shedge — Senior Flutter Developer</title>

  <!-- =====================================================
       GOOGLE FONTS
  ====================================================== -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  >


  <!-- =====================================================
       BOOTSTRAP
  ====================================================== -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >


  <!-- =====================================================
       BOOTSTRAP ICONS
  ====================================================== -->

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >


  <style>

    /* =====================================================
       ROOT
    ====================================================== */

    :root {

      --bg: #f4f7f8;

      --surface: #ffffff;

      --surface-soft: #f8fafb;

      --ink: #101828;

      --ink-2: #1d2939;

      --text: #344054;

      --muted: #667085;

      --light: #98a2b3;

      --border: #e4e7ec;

      --border-2: #eef1f4;

      --green: #087f5b;

      --green-dark: #065f46;

      --green-light: #e8f7f1;

      --green-border: #bce9da;

      --orange: #d97706;

      --orange-light: #fff7e8;

      --blue: #2563eb;

      --blue-light: #eff6ff;

      --purple: #7c3aed;

      --purple-light: #f5f3ff;

      --red: #dc2626;

      --red-light: #fef2f2;

      --radius: 16px;

      --shadow:
        0 18px 50px rgba(16, 24, 40, 0.07);
    }


    /* =====================================================
       RESET
    ====================================================== */

    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      margin: 0;

      padding: 30px;

      background: var(--bg);

      color: var(--text);

      font-family: "DM Sans", sans-serif;

      line-height: 1.6;
    }


    a {
      text-decoration: none;
      color: inherit;
    }


    a:hover {
      color: inherit;
    }


    ::selection {

      background: #d1fae5;

      color: var(--green-dark);
    }


    h1,
    h2,
    h3,
    h4 {

      font-family: "Manrope", sans-serif;
    }


    /* =====================================================
       PAGE
    ====================================================== */

    .page {

      width: min(1180px, 100%);

      margin: auto;

      overflow: hidden;

      background: var(--surface);

      border: 1px solid var(--border);

      border-radius: 22px;

      box-shadow: var(--shadow);
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .header {

      position: relative;

      overflow: hidden;

      padding: 50px 55px;

      color: #ffffff;

      background:

        radial-gradient(
          circle at 90% 20%,
          rgba(45, 212, 191, 0.18),
          transparent 25%
        ),

        radial-gradient(
          circle at 0% 100%,
          rgba(16, 185, 129, 0.12),
          transparent 30%
        ),

        linear-gradient(
          135deg,
          #06130f,
          #09251d 55%,
          #0b3026
        );
    }


    .header-grid {

      position: relative;

      z-index: 2;

      display: grid;

      grid-template-columns: 1fr auto;

      align-items: end;

      gap: 35px;
    }


    .availability {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      width: fit-content;

      margin-bottom: 20px;

      padding: 7px 11px;

      border: 1px solid rgba(
        255,
        255,
        255,
        0.13
      );

      border-radius: 999px;

      background: rgba(
        255,
        255,
        255,
        0.06
      );

      color: #a7f3d0;

      font-size: 8px;

      font-weight: 800;

      letter-spacing: 1px;

      text-transform: uppercase;
    }


    .availability-dot {

      width: 7px;

      height: 7px;

      border-radius: 50%;

      background: #34d399;

      box-shadow:
        0 0 0 4px
        rgba(52, 211, 153, 0.1);
    }


    .name {

      margin: 0;

      color: #ffffff;

      font-size: clamp(
        42px,
        6vw,
        72px
      );

      font-weight: 800;

      line-height: 0.98;

      letter-spacing: -3px;
    }


    .headline {

      max-width: 850px;

      margin: 18px 0 0;

      color: #a7f3d0;

      font-size: 11px;

      font-weight: 800;

      line-height: 1.7;

      letter-spacing: 1.1px;

      text-transform: uppercase;
    }


    .intro {

      max-width: 800px;

      margin: 17px 0 0;

      color: #d1d5db;

      font-size: 11px;

      line-height: 1.85;
    }


    /* =====================================================
       HEADER LINKS
    ====================================================== */

    .header-links {

      display: flex;

      flex-wrap: wrap;

      gap: 7px;

      margin-top: 25px;
    }


    .header-link {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      padding: 8px 10px;

      border: 1px solid rgba(
        255,
        255,
        255,
        0.1
      );

      border-radius: 8px;

      background: rgba(
        255,
        255,
        255,
        0.045
      );

      color: #d1d5db;

      font-size: 8.5px;

      font-weight: 600;

      transition: 0.2s ease;
    }


    .header-link i {

      color: #5eead4;
    }


    .header-link:hover {

      transform: translateY(-2px);

      border-color: rgba(
        94,
        234,
        212,
        0.35
      );

      background: rgba(
        255,
        255,
        255,
        0.09
      );

      color: #ffffff;
    }


    /* =====================================================
       HEADER SIDE
    ====================================================== */

    .header-side {

      min-width: 205px;

      padding: 18px;

      border: 1px solid rgba(
        255,
        255,
        255,
        0.1
      );

      border-radius: 14px;

      background: rgba(
        255,
        255,
        255,
        0.045
      );

      backdrop-filter: blur(12px);
    }


    .side-label {

      color: #94a3b8;

      font-size: 7px;

      font-weight: 800;

      letter-spacing: 1.4px;

      text-transform: uppercase;
    }


    .side-value {

      margin-top: 5px;

      color: #ffffff;

      font-size: 13px;

      font-weight: 800;
    }


    .side-line {

      height: 1px;

      margin: 15px 0;

      background: rgba(
        255,
        255,
        255,
        0.1
      );
    }


    .side-item {

      display: flex;

      align-items: center;

      gap: 8px;

      margin-top: 8px;

      color: #cbd5e1;

      font-size: 8.5px;
    }


    .side-item i {

      color: #5eead4;
    }


    /* =====================================================
       BODY
    ====================================================== */

    .body {

      padding: 50px 55px 60px;
    }


    /* =====================================================
       SECTION
    ====================================================== */

    .section {

      margin-bottom: 55px;
    }


    .section:last-child {

      margin-bottom: 0;
    }


    .section-head {

      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 25px;
    }


    .section-number {

      color: var(--green);

      font-family: "Manrope", sans-serif;

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 1px;
    }


    .section-title {

      margin: 0;

      color: var(--ink);

      font-size: 14px;

      font-weight: 800;

      letter-spacing: -0.2px;
    }


    .section-rule {

      flex: 1;

      height: 1px;

      background:
        linear-gradient(
          90deg,
          var(--border),
          transparent
        );
    }


    /* =====================================================
       SUMMARY
    ====================================================== */

    .summary {

      display: grid;

      grid-template-columns: 1fr 260px;

      gap: 30px;

      padding: 27px;

      border: 1px solid var(--border);

      border-radius: var(--radius);

      background: var(--surface);
    }


    .summary-text {

      color: var(--text);

      font-size: 10.8px;

      line-height: 1.9;
    }


    .summary-text strong {

      color: var(--ink);

      font-weight: 800;
    }


    .summary-highlight {

      color: var(--green);

      font-weight: 800;
    }


    .stats {

      display: grid;

      grid-template-columns: repeat(
        2,
        1fr
      );

      gap: 8px;
    }


    .stat {

      padding: 13px;

      border: 1px solid var(--border-2);

      border-radius: 10px;

      background: var(--surface-soft);
    }


    .stat-number {

      color: var(--ink);

      font-family: "Manrope", sans-serif;

      font-size: 20px;

      font-weight: 800;
    }


    .stat-label {

      margin-top: 2px;

      color: var(--muted);

      font-size: 7px;

      font-weight: 800;

      line-height: 1.4;

      letter-spacing: 0.5px;

      text-transform: uppercase;
    }


    /* =====================================================
       SKILLS
    ====================================================== */

    .skill-table {

      overflow: hidden;

      border: 1px solid var(--border);

      border-radius: var(--radius);
    }


    .skill {

      display: grid;

      grid-template-columns: 190px 1fr;

      gap: 20px;

      padding: 14px 17px;

      border-bottom: 1px solid var(--border-2);
    }


    .skill:last-child {

      border-bottom: 0;
    }


    .skill-name {

      color: var(--ink);

      font-size: 9px;

      font-weight: 800;
    }


    .skill-name i {

      width: 17px;

      margin-right: 5px;

      color: var(--green);
    }


    .skill-list {

      display: flex;

      flex-wrap: wrap;

      gap: 5px;
    }


    .skill-tag {

      padding: 4px 7px;

      border: 1px solid #e4e7ec;

      border-radius: 5px;

      background: #fafbfc;

      color: #475467;

      font-size: 7.5px;

      font-weight: 600;
    }


    .skill-tag.main {

      border-color: var(--green-border);

      background: var(--green-light);

      color: var(--green-dark);

      font-weight: 800;
    }


    /* =====================================================
       EXPERIENCE
    ====================================================== */

    .timeline {

      position: relative;
    }


    .timeline::before {

      content: "";

      position: absolute;

      top: 8px;

      bottom: 8px;

      left: 5px;

      width: 1px;

      background: #d7e5df;
    }


    .experience {

      position: relative;

      padding-left: 30px;

      margin-bottom: 38px;
    }


    .experience:last-child {

      margin-bottom: 0;
    }


    .experience-dot {

      position: absolute;

      top: 5px;

      left: -1px;

      width: 13px;

      height: 13px;

      border: 3px solid #ffffff;

      border-radius: 50%;

      background: var(--green);

      box-shadow:
        0 0 0 1px var(--green-border);
    }


    .experience-head {

      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 20px;
    }


    .job {

      margin: 0;

      color: var(--ink);

      font-size: 13px;

      font-weight: 800;
    }


    .company {

      margin-top: 3px;

      color: var(--green);

      font-size: 9px;

      font-weight: 800;
    }


    .period {

      white-space: nowrap;

      padding: 5px 8px;

      border-radius: 6px;

      background: var(--orange-light);

      color: var(--orange);

      font-size: 7px;

      font-weight: 800;
    }


    .experience-list {

      margin: 13px 0 0;

      padding-left: 17px;
    }


    .experience-list li {

      margin-bottom: 6px;

      color: var(--muted);

      font-size: 9.3px;

      line-height: 1.7;
    }


    .experience-list li::marker {

      color: var(--green);
    }


    .experience-list strong {

      color: var(--ink-2);

      font-weight: 700;
    }


    /* =====================================================
       PROJECT INTRO
    ====================================================== */

    .projects-intro {

      max-width: 850px;

      margin-bottom: 30px;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.8;
    }


    /* =====================================================
       PROJECT
    ====================================================== */

    .project {

      position: relative;

      display: grid;

      grid-template-columns: 170px 1fr;

      gap: 35px;

      padding: 30px 0;

      border-top: 1px solid var(--border);

      page-break-inside: avoid;
    }


    .project:first-child {

      padding-top: 0;

      border-top: 0;
    }


    .project:last-child {

      padding-bottom: 0;
    }


    /* =====================================================
       PROJECT SIDEBAR
    ====================================================== */

    .project-meta {

      position: relative;
    }


    .project-index {

      color: var(--green);

      font-family: "Manrope", sans-serif;

      font-size: 8px;

      font-weight: 800;

      letter-spacing: 1.5px;

      text-transform: uppercase;
    }


    .project-icon {

      display: flex;

      align-items: center;

      justify-content: center;

      width: 48px;

      height: 48px;

      margin-top: 10px;

      border: 1px solid var(--border);

      border-radius: 12px;

      background: var(--surface-soft);

      color: var(--green);

      font-size: 19px;
    }


    .project-category {

      margin-top: 12px;

      color: var(--muted);

      font-size: 7.5px;

      font-weight: 800;

      line-height: 1.6;

      letter-spacing: 0.5px;

      text-transform: uppercase;
    }


    .project-stack-mini {

      display: flex;

      flex-wrap: wrap;

      gap: 4px;

      margin-top: 10px;
    }


    .mini-tag {

      padding: 3px 5px;

      border: 1px solid var(--border);

      border-radius: 4px;

      color: var(--muted);

      background: #fff;

      font-size: 6.8px;

      font-weight: 700;
    }


    /* =====================================================
       PROJECT CONTENT
    ====================================================== */

    .project-content {

      min-width: 0;
    }


    .project-title-row {

      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 20px;
    }


    .project-title {

      margin: 0;

      color: var(--ink);

      font-size: 18px;

      font-weight: 800;

      letter-spacing: -0.4px;
    }


    .project-subtitle {

      margin-top: 5px;

      color: var(--green);

      font-size: 8px;

      font-weight: 800;

      letter-spacing: 0.8px;

      text-transform: uppercase;
    }


    .project-link {

      display: inline-flex;

      align-items: center;

      gap: 5px;

      white-space: nowrap;

      padding: 6px 9px;

      border: 1px solid var(--green-border);

      border-radius: 6px;

      background: var(--green-light);

      color: var(--green-dark);

      font-size: 7.5px;

      font-weight: 800;
    }


    .project-link:hover {

      background: var(--green-dark);

      color: #ffffff;
    }


    .project-overview {

      margin: 15px 0 0;

      color: var(--text);

      font-size: 10.2px;

      line-height: 1.85;
    }


    .project-overview strong {

      color: var(--ink);

      font-weight: 800;
    }


    /* =====================================================
       PROJECT DETAIL TEXT
    ====================================================== */

    .project-details {

      margin-top: 20px;

      padding: 20px;

      border-left: 3px solid var(--green);

      border-radius: 0 10px 10px 0;

      background:
        linear-gradient(
          90deg,
          #f5fbf8,
          #ffffff
        );
    }


    .project-details p {

      margin: 0 0 10px;

      color: var(--text);

      font-size: 9.4px;

      line-height: 1.78;
    }


    .project-details p:last-child {

      margin-bottom: 0;
    }


    .project-details strong {

      color: var(--ink);

      font-weight: 800;
    }


    /* =====================================================
       PROJECT BULLET DETAILS
    ====================================================== */

    .project-points {

      display: grid;

      grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
      );

      gap: 8px 25px;

      margin-top: 15px;

      padding: 0;

      list-style: none;
    }


    .project-points li {

      position: relative;

      padding-left: 15px;

      color: var(--muted);

      font-size: 8.8px;

      line-height: 1.7;
    }


    .project-points li::before {

      content: "";

      position: absolute;

      left: 0;

      top: 7px;

      width: 5px;

      height: 5px;

      border-radius: 50%;

      background: var(--green);
    }


    .project-points strong {

      color: var(--ink-2);

      font-weight: 800;
    }


    /* =====================================================
       PROJECT TECHNOLOGIES
    ====================================================== */

    .project-footer {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      margin-top: 19px;

      padding-top: 15px;

      border-top: 1px solid var(--border-2);
    }


    .technology-list {

      display: flex;

      flex-wrap: wrap;

      gap: 5px;
    }


    .technology {

      padding: 4px 7px;

      border: 1px solid #dfe5e8;

      border-radius: 5px;

      background: #f9fafb;

      color: #475467;

      font-size: 7px;

      font-weight: 700;
    }


    /* =====================================================
       EDUCATION
    ====================================================== */

    .education {

      display: grid;

      grid-template-columns: repeat(
        2,
        1fr
      );

      gap: 10px;
    }


    .education-item {

      padding: 17px;

      border: 1px solid var(--border);

      border-radius: 12px;

      background: #ffffff;
    }


    .degree {

      color: var(--ink);

      font-size: 10px;

      font-weight: 800;
    }


    .institution {

      margin-top: 4px;

      color: var(--muted);

      font-size: 8.5px;
    }


    .education-year {

      margin-top: 9px;

      color: var(--green);

      font-size: 7px;

      font-weight: 800;

      letter-spacing: 0.5px;
    }


    /* =====================================================
       CERTIFICATE
    ====================================================== */

    .certificate {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding: 20px;

      border: 1px solid var(--border);

      border-radius: 13px;

      background: var(--surface-soft);
    }


    .certificate-info {

      display: flex;

      align-items: center;

      gap: 12px;
    }


    .certificate-icon {

      display: flex;

      align-items: center;

      justify-content: center;

      width: 43px;

      height: 43px;

      border-radius: 10px;

      background: var(--orange-light);

      color: var(--orange);

      font-size: 18px;
    }


    .certificate-title {

      color: var(--ink);

      font-size: 10px;

      font-weight: 800;
    }


    .certificate-description {

      margin-top: 2px;

      color: var(--muted);

      font-size: 7.8px;
    }


    .certificate-button {

      display: inline-flex;

      align-items: center;

      gap: 6px;

      padding: 7px 10px;

      border-radius: 6px;

      background: var(--ink);

      color: #ffffff;

      font-size: 7.5px;

      font-weight: 800;
    }


    .certificate-button:hover {

      background: var(--green-dark);

      color: #ffffff;
    }


    /* =====================================================
       FOOTER
    ====================================================== */

    .footer {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding: 17px 55px;

      border-top: 1px solid var(--border);

      background: #fafbfc;

      color: var(--muted);

      font-size: 7.5px;
    }


    .footer strong {

      color: var(--ink);
    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @media (max-width: 900px) {

      body {
        padding: 15px;
      }


      .header,
      .body {

        padding-left: 35px;

        padding-right: 35px;
      }


      .footer {

        padding-left: 35px;

        padding-right: 35px;
      }


      .header-grid {

        grid-template-columns: 1fr;
      }


      .header-side {

        width: 100%;
      }


      .summary {

        grid-template-columns: 1fr;
      }


      .project {

        grid-template-columns: 125px 1fr;

        gap: 25px;
      }

    }


    @media (max-width: 700px) {

      body {
        padding: 0;
      }


      .page {

        border: 0;

        border-radius: 0;

        box-shadow: none;
      }


      .header {

        padding: 35px 22px;
      }


      .body {

        padding: 35px 22px 45px;
      }


      .footer {

        flex-direction: column;

        align-items: flex-start;

        padding: 16px 22px;
      }


      .name {

        font-size: 45px;

        letter-spacing: -2px;
      }


      .headline {

        font-size: 8.5px;
      }


      .skill {

        grid-template-columns: 1fr;

        gap: 8px;
      }


      .experience-head {

        flex-direction: column;

        gap: 8px;
      }


      .project {

        grid-template-columns: 1fr;

        gap: 15px;
      }


      .project-meta {

        display: flex;

        align-items: center;

        gap: 12px;

        flex-wrap: wrap;
      }


      .project-icon {

        margin-top: 0;
      }


      .project-category {

        margin-top: 0;
      }


      .project-stack-mini {

        margin-top: 0;
      }


      .project-title-row {

        flex-direction: column;

        gap: 10px;
      }


      .project-link {

        width: fit-content;
      }


      .project-points {

        grid-template-columns: 1fr;
      }


      .project-footer {

        align-items: flex-start;

        flex-direction: column;
      }


      .education {

        grid-template-columns: 1fr;
      }


      .certificate {

        align-items: flex-start;

        flex-direction: column;
      }

    }


    /* =====================================================
       PRINT
    ====================================================== */

    @media print {

      @page {

        size: A4;

        margin: 7mm;
      }


      html,
