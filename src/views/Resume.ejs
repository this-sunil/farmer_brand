<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Sunil Shedge | Senior Flutter Developer</title>

  <meta
    name="description"
    content="Sunil Shedge - Senior Flutter Developer with 4+ years of experience building production-ready Android, iOS and Web applications, backend systems, APIs, cloud integrations, payment systems and CI/CD pipelines."
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --indigo: #4338ca;
      --indigo-dark: #312e81;
      --indigo-deep: #1e1b4b;

      --violet: #6d28d9;
      --purple: #7c3aed;

      --text: #172033;
      --text-soft: #526071;
      --muted: #718096;

      --bg: #f6f7fb;
      --card: #ffffff;
      --border: #e6e8f0;

      --light-indigo: #eef2ff;
      --light-violet: #f5f3ff;

      --success: #047857;
      --success-bg: #ecfdf5;

      --danger: #be123c;
      --danger-bg: #fff1f2;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "DM Sans", sans-serif;
      line-height: 1.65;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .resume-wrapper {
      max-width: 1120px;
      margin: 35px auto;
      padding: 0 18px;
    }

    /* =========================================================
       HEADER
    ========================================================== */

    .resume-header {
      position: relative;
      overflow: hidden;

      border-radius: 24px;
      padding: 42px 44px;

      color: #fff;

      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(139, 92, 246, 0.65),
          transparent 28%
        ),
        radial-gradient(
          circle at 10% 90%,
          rgba(99, 102, 241, 0.35),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #312e81 0%,
          #4338ca 48%,
          #6d28d9 100%
        );

      box-shadow: 0 20px 45px rgba(49, 46, 129, 0.18);
    }

    .resume-header::after {
      content: "";

      position: absolute;

      width: 230px;
      height: 230px;

      right: -80px;
      bottom: -100px;

      border: 1px solid rgba(255, 255, 255, 0.18);

      border-radius: 50%;
    }

    .header-content {
      position: relative;
      z-index: 2;
    }

    .name {
      margin: 0;

      font-family: "Manrope", sans-serif;

      font-size: clamp(2.2rem, 5vw, 3.7rem);

      font-weight: 800;

      letter-spacing: -1.8px;
    }

    .designation {
      margin-top: 7px;

      font-size: 1.12rem;
      font-weight: 600;

      color: rgba(255, 255, 255, 0.92);
    }

    .header-description {
      max-width: 820px;

      margin: 16px 0 24px;

      color: rgba(255, 255, 255, 0.82);

      font-size: 0.98rem;
    }

    .contact-grid {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;
    }

    .contact-item {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 8px 12px;

      border: 1px solid rgba(255, 255, 255, 0.16);

      border-radius: 10px;

      background: rgba(255, 255, 255, 0.09);

      backdrop-filter: blur(8px);

      color: #fff;

      font-size: 0.84rem;
    }

    .contact-item:hover {
      background: rgba(255, 255, 255, 0.16);
      color: #fff;
    }

    /* =========================================================
       MAIN CARD
    ========================================================== */

    .resume-card {
      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 20px;

      margin-top: 18px;

      padding: 30px 34px;

      box-shadow: 0 10px 30px rgba(31, 41, 55, 0.045);
    }

    .section-heading {
      display: flex;

      align-items: center;

      gap: 12px;

      margin-bottom: 22px;
    }

    .section-icon {
      width: 38px;
      height: 38px;

      display: flex;

      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 11px;

      color: #fff;

      background: linear-gradient(
        135deg,
        var(--indigo),
        var(--violet)
      );

      box-shadow: 0 8px 18px rgba(67, 56, 202, 0.2);
    }

    .section-title {
      margin: 0;

      font-family: "Manrope", sans-serif;

      font-size: 1.22rem;

      font-weight: 800;

      letter-spacing: -0.3px;
    }

    .section-line {
      height: 1px;

      flex: 1;

      background: var(--border);
    }

    /* =========================================================
       SUMMARY
    ========================================================== */

    .summary {
      margin: 0;

      color: var(--text-soft);

      font-size: 0.98rem;

      line-height: 1.8;
    }

    .summary strong {
      color: var(--text);
    }

    /* =========================================================
       SKILLS
    ========================================================== */

    .skill-group {
      padding: 17px;

      height: 100%;

      border: 1px solid var(--border);

      border-radius: 14px;

      background: #fff;
    }

    .skill-heading {
      display: flex;

      align-items: center;

      gap: 8px;

      margin-bottom: 10px;

      color: var(--text);

      font-size: 0.88rem;

      font-weight: 800;
    }

    .skill-heading i {
      color: var(--indigo);
    }

    .skill-list {
      display: flex;

      flex-wrap: wrap;

      gap: 7px;
    }

    .skill-pill {
      padding: 6px 9px;

      border: 1px solid #dfe3f0;

      border-radius: 7px;

      background: #f9fafc;

      color: #364152;

      font-size: 0.73rem;

      font-weight: 600;
    }

    .skill-pill.primary {
      border-color: #c7d2fe;

      background: var(--light-indigo);

      color: var(--indigo-dark);
    }

    /* =========================================================
       EDUCATION
       Professional left-aligned layout
       No section underline
    ========================================================== */

    .education-section .section-heading {
      margin-bottom: 20px;
    }

    .education-list {
      display: flex;

      flex-direction: column;
    }

    .education-item {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 24px;

      padding: 15px 0;

      border-bottom: 1px solid var(--border);
    }

    .education-item:first-child {
      padding-top: 0;
    }

    .education-item:last-child {
      border-bottom: 0;

      padding-bottom: 0;
    }

    .education-content {
      flex: 1;

      min-width: 0;
    }

    .degree {
      margin: 0;

      font-family: "Manrope", sans-serif;

      color: var(--text);

      font-size: 0.94rem;

      font-weight: 800;

      line-height: 1.4;
    }

    .institution {
      margin-top: 4px;

      color: var(--indigo);

      font-size: 0.84rem;

      font-weight: 700;

      line-height: 1.5;
    }

    .education-details {
      margin-top: 4px;

      color: var(--text-soft);

      font-size: 0.78rem;

      font-weight: 500;
    }

    .education-date {
      flex-shrink: 0;

      min-width: 90px;

      padding-top: 2px;

      text-align: right;

      color: var(--muted);

      font-size: 0.78rem;

      font-weight: 700;
    }

    /* =========================================================
       PROJECTS
    ========================================================== */

    .project-grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 15px;
    }

    .project-card {
      position: relative;

      height: 100%;

      padding: 20px;

      border: 1px solid var(--border);

      border-radius: 15px;

      background:
        linear-gradient(
          145deg,
          #ffffff 0%,
          #fbfbff 100%
        );

      transition: all 0.2s ease;
    }

    .project-card:hover {
      transform: translateY(-2px);

      border-color: #c7c9f7;

      box-shadow:
        0 10px 28px rgba(67, 56, 202, 0.08);
    }

    .project-title-row {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 12px;

      margin-bottom: 8px;
    }

    .project-title {
      margin: 0;

      font-family: "Manrope", sans-serif;

      font-size: 0.98rem;

      font-weight: 800;
    }

    .project-type {
      flex-shrink: 0;

      padding: 4px 8px;

      border-radius: 6px;

      color: var(--indigo-dark);

      background: var(--light-indigo);

      font-size: 0.66rem;

      font-weight: 700;

      text-transform: uppercase;

      letter-spacing: 0.4px;
    }

    .project-description {
      margin: 0;

      color: var(--text-soft);

      font-size: 0.84rem;

      line-height: 1.65;
    }

    .tech-tags {
      display: flex;

      flex-wrap: wrap;

      gap: 6px;

      margin-top: 13px;
    }

    .tech-tag {
      padding: 4px 8px;

      border-radius: 6px;

      background: #f1f3f9;

      color: #4b5568;

      font-size: 0.69rem;

      font-weight: 600;
    }

    .project-link {
      display: inline-flex;

      align-items: center;

      gap: 5px;

      margin-top: 13px;

      color: var(--indigo);

      font-size: 0.78rem;

      font-weight: 700;
    }

    .project-link:hover {
      color: var(--indigo-dark);
    }

    /* =========================================================
       INTERNSHIP
    ========================================================== */

    .internship-box {
      padding: 19px;

      border: 1px solid #ddd6fe;

      border-radius: 14px;

      background:
        linear-gradient(
          135deg,
          #fafaff,
          #f7f3ff
        );
    }

    .internship-title {
      margin: 0;

      font-family: "Manrope", sans-serif;

      font-size: 0.98rem;

      font-weight: 800;
    }

    .internship-description {
      margin: 7px 0 0;

      color: var(--text-soft);

      font-size: 0.86rem;
    }

    /* =========================================================
       EXPERIENCE
    ========================================================== */

    .experience-item {
      position: relative;

      padding-left: 28px;

      margin-bottom: 32px;
    }

    .experience-item:last-child {
      margin-bottom: 0;
    }

    .experience-item::before {
      content: "";

      position: absolute;

      left: 0;

      top: 7px;

      width: 11px;

      height: 11px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          var(--indigo),
          var(--violet)
        );

      box-shadow:
        0 0 0 5px var(--light-indigo);
    }

    .experience-item::after {
      content: "";

      position: absolute;

      left: 5px;

      top: 22px;

      bottom: -32px;

      width: 1px;

      background: #dfe3f0;
    }

    .experience-item:last-child::after {
      display: none;
    }

    .job-header {
      display: flex;

      justify-content: space-between;

      align-items: flex-start;

      gap: 20px;
    }

    .job-title {
      margin: 0;

      font-family: "Manrope", sans-serif;

      font-size: 1.05rem;

      font-weight: 800;

      color: var(--text);
    }

    .company {
      margin-top: 3px;

      color: var(--indigo);

      font-weight: 700;

      font-size: 0.91rem;
    }

    .date-badge {
      white-space: nowrap;

      padding: 6px 11px;

      border-radius: 8px;

      background: var(--light-indigo);

      color: var(--indigo-dark);

      font-size: 0.76rem;

      font-weight: 700;
    }

    .experience-list {
      margin: 13px 0 0;

      padding-left: 19px;
    }

    .experience-list li {
      margin-bottom: 8px;

      color: var(--text-soft);

      font-size: 0.91rem;
    }

    .experience-list li::marker {
      color: var(--indigo);
    }

    .experience-list strong {
      color: var(--text);
    }

    /* =========================================================
       PROFESSIONAL LINKS
    ========================================================== */

    .links-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 12px;
    }

    .profile-link {
      display: flex;

      align-items: center;

      gap: 10px;

      padding: 13px;

      border: 1px solid var(--border);

      border-radius: 11px;

      background: #fff;

      transition: 0.2s ease;
    }

    .profile-link:hover {
      border-color: #c7d2fe;

      background: var(--light-indigo);

      color: var(--indigo-dark);
    }

    .profile-link i {
      font-size: 1rem;

      color: var(--indigo);
    }

    .profile-link span {
      overflow: hidden;

      text-overflow: ellipsis;

      white-space: nowrap;

      font-size: 0.77rem;

      font-weight: 700;
    }

    /* =========================================================
       FOOTER
    ========================================================== */

    .resume-footer {
      padding: 25px 10px 35px;

      text-align: center;

      color: var(--muted);

      font-size: 0.75rem;
    }

    /* =========================================================
       PRINT / A4
    ========================================================== */

    @media print {

      @page {
        size: A4;

        margin: 10mm;
      }

      body {
        background: #fff;
      }

      .resume-wrapper {
        max-width: none;

        margin: 0;

        padding: 0;
      }

      .resume-header {
        box-shadow: none;

        border-radius: 0;

        -webkit-print-color-adjust: exact;

        print-color-adjust: exact;
      }

      .resume-card {
        box-shadow: none;

        margin-top: 12px;

        break-inside: avoid;
      }

      .project-card,
      .skill-group,
      .internship-box,
      .profile-link {
        break-inside: avoid;
      }

      .education-item {
        break-inside: avoid;
      }

      a {
        text-decoration: none;
      }

      .resume-footer {
        display: none;
      }
    }

    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @media (max-width: 900px) {

      .project-grid {
        grid-template-columns: 1fr;
      }

      .links-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {

      .resume-wrapper {
        margin: 15px auto;

        padding: 0 10px;
      }

      .resume-header {
        padding: 30px 22px;

        border-radius: 18px;
      }

      .resume-card {
        padding: 23px 20px;

        border-radius: 16px;
      }

      .job-header {
        flex-direction: column;

        gap: 8px;
      }

      .education-item {
        flex-direction: column;

        gap: 5px;
      }

      .education-date {
        min-width: auto;

        padding-top: 0;

        text-align: left;
      }

      .contact-grid {
        flex-direction: column;

        align-items: stretch;
      }

      .contact-item {
        width: 100%;
      }
    }
  </style>
</head>

