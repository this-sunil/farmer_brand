<style>
  :root{
    --ink:#0b1220;
    --muted:#5b6472;
    --gold:#c9922f;
    --teal:#0f766e;
    --paper:#ffffff;
    --bg:#f4f1ea;
    --line:#e7e2d6;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    font-family:"Inter",sans-serif;
    color:var(--ink);
    padding:44px 0;
  }
  h1,h2,h3,.brand{font-family:"Sora",sans-serif;}
  .resume{
    max-width:980px;
    margin:0 auto;
    background:var(--paper);
    border-radius:6px;
    box-shadow:0 30px 70px rgba(11,18,32,.15);
    overflow:hidden;
  }
  /* Top identity bar */
  .id-bar{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:20px;
    padding:50px 56px 28px;
    border-bottom:4px solid var(--gold);
  }
  .id-name{
    font-size:2.5rem;
    font-weight:800;
    margin:0;
    letter-spacing:-.5px;
  }
  .id-role{
    font-size:.95rem;
    font-weight:600;
    color:var(--teal);
    text-transform:uppercase;
    letter-spacing:2.5px;
    margin-top:6px;
  }
  .id-contacts{
    text-align:right;
    font-size:.85rem;
    color:var(--muted);
    line-height:1.9;
  }
  .id-contacts a{color:var(--muted); text-decoration:none;}
  .id-contacts a:hover{color:var(--teal);}
  .id-contacts i{width:16px; color:var(--gold); margin-right:6px;}

  /* Skill strip */
  .skill-strip{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    padding:22px 56px;
    background:#faf8f3;
    border-bottom:1px solid var(--line);
  }
  .skill-strip-wrap{
    padding:22px 56px 26px;
    background:#faf8f3;
    border-bottom:1px solid var(--line);
  }
  .skill-strip-head{
    font-size:.78rem;
    font-weight:800;
    letter-spacing:2.5px;
    text-transform:uppercase;
    color:var(--teal);
    margin:0 0 16px;
    display:flex;
    align-items:center;
    gap:12px;
  }
  .skill-strip-head::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }
  .skill-cat{
    margin-bottom:10px;
    font-size:.88rem;
    line-height:1.6;
    color:#2b3340;
  }
  .skill-cat:last-child{margin-bottom:0;}
  .skill-cat-label{
    font-weight:700;
    color:var(--ink);
  }

  .content{padding:44px 56px 50px;}

  h2.head{
    font-size:.78rem;
    font-weight:800;
    letter-spacing:2.5px;
    text-transform:uppercase;
    color:var(--teal);
    margin:0 0 18px;
    display:flex;
    align-items:center;
    gap:12px;
  }
  h2.head::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }

  .summary{
    font-size:1rem;
    line-height:1.85;
    color:#2b3340;
    margin:0 0 40px;
  }

  /* Timeline */
  .timeline{
    position:relative;
    margin-bottom:44px;
    padding-left:28px;
    border-left:2px solid var(--line);
  }
  .tl-item{
    position:relative;
    padding-bottom:32px;
  }
  .tl-item:last-child{padding-bottom:0;}
  .tl-item::before{
    content:"";
    position:absolute;
    left:-34px;
    top:4px;
    width:12px;
    height:12px;
    border-radius:50%;
    background:var(--gold);
    border:3px solid #fff;
    box-shadow:0 0 0 2px var(--gold);
  }
  .tl-row{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:2px;
  }
  .tl-title{font-size:1.05rem; font-weight:700; color:var(--ink);}
  .tl-company{font-size:.88rem; font-weight:600; color:var(--teal);}
  .tl-dates{
    font-size:.78rem;
    font-weight:700;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:.5px;
    white-space:nowrap;
  }
  .tl-list{
    margin:10px 0 0;
    padding-left:18px;
  }
  .tl-list li{
    font-size:.9rem;
    line-height:1.6;
    color:#3d4653;
    margin-bottom:6px;
  }
  .tl-list li strong{color:var(--ink);}

  /* Projects */
  .proj-card{
    border:1px solid var(--line);
    border-radius:8px;
    padding:18px 20px;
    height:100%;
    background:#fff;
  }
  .proj-title{
    font-size:.95rem;
    font-weight:700;
    color:var(--ink);
    margin-bottom:4px;
  }
  .proj-tag{
    font-size:.72rem;
    font-weight:700;
    color:var(--gold);
    text-transform:uppercase;
    letter-spacing:.6px;
    margin-bottom:8px;
    display:block;
  }
  .proj-desc{
    font-size:.85rem;
    color:var(--muted);
    line-height:1.6;
    margin-bottom:12px;
  }
  .proj-link{
    font-size:.78rem;
    font-weight:700;
    color:var(--teal);
    text-decoration:none;
  }
  .proj-link:hover{color:var(--gold);}

  /* Education / Certs */
  .edu-row{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:4px;
    padding:12px 0;
    border-bottom:1px solid var(--line);
  }
  .edu-row:last-child{border-bottom:none;}
  .edu-degree{font-size:.92rem; font-weight:700; color:var(--ink);}
  .edu-school{font-size:.82rem; color:var(--muted);}
  .edu-year{font-size:.8rem; font-weight:600; color:var(--muted); white-space:nowrap;}

  .declare{
    margin-top:40px;
    padding-top:20px;
    border-top:1px solid var(--line);
    font-size:.8rem;
    color:var(--muted);
    text-align:center;
    font-style:italic;
  }

  @media (max-width:768px){
    .id-bar{padding:36px 24px 20px;}
    .id-contacts{text-align:left;}
    .skill-strip-wrap{padding:18px 24px 22px;}
    .content{padding:32px 24px 40px;}
  }
  @media print{
    body{background:#fff; padding:0;}
    .resume{box-shadow:none; max-width:100%;}
  }
</style>
</head>
