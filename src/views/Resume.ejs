<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sunil Shedge — Senior Flutter Developer | Full Stack Developer. 4+ years building production-grade Flutter applications, backend APIs, PostgreSQL systems and CI/CD pipelines.">
  <title>Sunil Shedge | Senior Flutter Developer</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --ink:#172033;
      --ink-2:#344054;
      --muted:#667085;
      --line:#e5e7eb;
      --surface:#ffffff;
      --page:#f4f6f8;
      --brand:#0f766e;
      --brand-dark:#115e59;
      --brand-soft:#ecfdf5;
      --accent:#f59e0b;
      --navy:#0f172a;
      --radius:18px;
      --shadow:0 14px 40px rgba(15,23,42,.07);
    }

    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      margin:0;
      background:var(--page);
      color:var(--ink);
      font-family:"DM Sans",sans-serif;
      line-height:1.6;
    }
    a { color:inherit; text-decoration:none; }

    .resume {
      max-width:1120px;
      margin:28px auto;
      padding:0 16px 40px;
    }

    /* ART = Attract → Relevance → Trust */
    .hero {
      position:relative;
      overflow:hidden;
      color:#fff;
      border-radius:24px;
      padding:42px 44px;
      background:
        radial-gradient(circle at 88% 15%, rgba(20,184,166,.34), transparent 26%),
        radial-gradient(circle at 8% 92%, rgba(245,158,11,.18), transparent 24%),
        linear-gradient(135deg,#0f172a 0%,#12343b 58%,#0f766e 100%);
      box-shadow:0 22px 50px rgba(15,23,42,.18);
    }

    .hero:before {
      content:"";
      position:absolute;
      width:300px;height:300px;
      right:-145px;bottom:-155px;
      border:1px solid rgba(255,255,255,.15);
      border-radius:50%;
    }

    .hero-inner { position:relative; z-index:2; }

    .eyebrow {
      display:inline-flex;
      align-items:center;
      gap:8px;
      margin-bottom:12px;
      padding:6px 10px;
      border:1px solid rgba(255,255,255,.16);
      border-radius:999px;
      background:rgba(255,255,255,.08);
      color:#d1fae5;
      font-size:.73rem;
      font-weight:800;
      letter-spacing:.7px;
      text-transform:uppercase;
    }

    h1 {
      margin:0;
      font-family:"Manrope",sans-serif;
      font-size:clamp(2.3rem,6vw,4.2rem);
      line-height:1;
      letter-spacing:-2.2px;
      font-weight:800;
    }

    .role {
      margin-top:10px;
      font-family:"Manrope",sans-serif;
      font-size:1.16rem;
      font-weight:700;
      color:#ccfbf1;
    }

    .hero-copy {
      max-width:820px;
      margin:16px 0 24px;
      color:rgba(255,255,255,.82);
      font-size:.98rem;
    }

    .contact-row {
      display:flex;
      flex-wrap:wrap;
      gap:9px;
    }

    .contact {
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 11px;
      border:1px solid rgba(255,255,255,.14);
      border-radius:10px;
      background:rgba(255,255,255,.07);
      color:#fff;
      font-size:.78rem;
    }

    .contact:hover { background:rgba(255,255,255,.14); color:#fff; }

    .proof-strip {
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:10px;
      margin-top:18px;
    }

    .proof {
      padding:15px;
      border:1px solid rgba(255,255,255,.11);
      border-radius:13px;
      background:rgba(255,255,255,.06);
    }

    .proof strong {
      display:block;
      font-family:"Manrope",sans-serif;
      font-size:1.1rem;
      color:#fff;
    }

    .proof span {
      display:block;
      margin-top:2px;
      color:rgba(255,255,255,.65);
      font-size:.68rem;
    }

    .section {
      margin-top:16px;
      padding:28px 32px;
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:var(--surface);
      box-shadow:var(--shadow);
    }

    .section-head {
      display:flex;
      align-items:center;
      gap:12px;
      margin-bottom:20px;
    }

    .section-icon {
      width:38px;height:38px;
      display:grid;place-items:center;
      flex:0 0 auto;
      border-radius:11px;
      background:var(--brand-soft);
      color:var(--brand);
      font-size:1rem;
    }

    .section-title {
      margin:0;
      font-family:"Manrope",sans-serif;
      font-size:1.13rem;
      font-weight:800;
      letter-spacing:-.2px;
    }

    .section-rule { flex:1; height:1px; background:var(--line); }

    .summary {
      margin:0;
      color:var(--ink-2);
      font-size:.94rem;
      line-height:1.8;
    }

    .summary b { color:var(--ink); }

    .skill-card {
      height:100%;
      padding:16px;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fff;
    }

    .skill-title {
      display:flex;
      align-items:center;
      gap:8px;
      margin-bottom:10px;
      font-size:.82rem;
      font-weight:800;
    }

    .skill-title i { color:var(--brand); }

    .tags { display:flex; flex-wrap:wrap; gap:6px; }

    .tag {
      display:inline-flex;
      padding:5px 8px;
      border:1px solid #e5e7eb;
      border-radius:7px;
      background:#f8fafc;
      color:#475467;
      font-size:.68rem;
      font-weight:700;
    }

    .tag.hot {
      border-color:#99f6e4;
      background:#f0fdfa;
      color:#115e59;
    }

    .timeline {
      position:relative;
    }

    .job {
      position:relative;
      padding:0 0 30px 28px;
      margin-bottom:4px;
    }

    .job:last-child { padding-bottom:0; }

    .job:before {
      content:"";
      position:absolute;
      left:0; top:6px;
      width:11px;height:11px;
      border-radius:50%;
      background:var(--brand);
      box-shadow:0 0 0 5px var(--brand-soft);
    }

    .job:not(:last-child):after {
      content:"";
      position:absolute;
      left:5px; top:22px; bottom:0;
      width:1px;
      background:#d7dee7;
    }

    .job-head {
      display:flex;
      justify-content:space-between;
      gap:20px;
      align-items:flex-start;
    }

    .job-title {
      margin:0;
      font-family:"Manrope",sans-serif;
      font-size:1rem;
      font-weight:800;
    }

    .company {
      margin-top:2px;
      color:var(--brand-dark);
      font-size:.84rem;
      font-weight:800;
    }

    .date {
      white-space:nowrap;
      padding:5px 9px;
      border-radius:7px;
      background:#f0fdfa;
      color:#115e59;
      font-size:.69rem;
      font-weight:800;
    }

    .job-list {
      margin:11px 0 0;
      padding-left:18px;
    }

    .job-list li {
      margin-bottom:6px;
      color:#475467;
      font-size:.82rem;
    }

    .job-list li::marker { color:var(--brand); }

    .impact {
      display:inline-block;
      margin-top:8px;
      padding:5px 8px;
      border-radius:7px;
      background:#fffbeb;
      color:#92400e;
      font-size:.68rem;
      font-weight:800;
    }

    .project {
      height:100%;
      padding:18px;
      border:1px solid var(--line);
      border-radius:14px;
      background:linear-gradient(145deg,#fff,#f8fafc);
    }

    .project-head {
      display:flex;
      justify-content:space-between;
      gap:10px;
      margin-bottom:7px;
    }

    .project h3 {
      margin:0;
      font-family:"Manrope",sans-serif;
      font-size:.94rem;
      font-weight:800;
    }

    .project-type {
      flex:0 0 auto;
      padding:4px 7px;
      border-radius:6px;
      background:#f0fdfa;
      color:#115e59;
      font-size:.61rem;
      font-weight:800;
      text-transform:uppercase;
    }

    .project p {
      margin:0;
      color:#667085;
      font-size:.76rem;
      line-height:1.65;
    }

    .project-links {
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:11px;
    }

    .project-link {
      display:inline-flex;
      align-items:center;
      gap:5px;
      color:var(--brand-dark);
      font-size:.69rem;
      font-weight:800;
    }

    .education {
      display:flex;
      justify-content:space-between;
      gap:20px;
      padding:13px 0;
      border-bottom:1px solid var(--line);
    }

    .education:first-child { padding-top:0; }
    .education:last-child { border-bottom:0; padding-bottom:0; }

    .degree {
      margin:0;
      font-family:"Manrope",sans-serif;
      font-size:.88rem;
      font-weight:800;
    }

    .school {
      margin-top:2px;
      color:var(--brand-dark);
      font-size:.76rem;
      font-weight:800;
    }

    .education-meta {
      margin-top:2px;
      color:var(--muted);
      font-size:.7rem;
    }

    .edu-year {
      white-space:nowrap;
      color:var(--muted);
      font-size:.7rem;
      font-weight:800;
    }

    .links {
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:10px;
    }

    .link-card {
      display:flex;
      align-items:center;
      gap:9px;
      padding:12px;
      border:1px solid var(--line);
      border-radius:11px;
      background:#fff;
      font-size:.72rem;
      font-weight:800;
    }

    .link-card i { color:var(--brand); font-size:1rem; }
    .link-card:hover { border-color:#99f6e4; background:#f0fdfa; color:#115e59; }

    .footer {
      padding:18px 0 0;
      text-align:center;
      color:var(--muted);
      font-size:.68rem;
    }

    @media (max-width:900px) {
      .proof-strip { grid-template-columns:repeat(2,1fr); }
      .links { grid-template-columns:1fr; }
    }

    @media (max-width:700px) {
      .resume { margin:12px auto; padding:0 9px 25px; }
      .hero { padding:30px 22px; border-radius:18px; }
      .section { padding:22px 19px; border-radius:15px; }
      .job-head { flex-direction:column; gap:7px; }
      .education { flex-direction:column; gap:4px; }
      .edu-year { order:-1; }
      .contact-row { flex-direction:column; }
      .contact { width:100%; }
    }

    @media print {
      @page { size:A4; margin:9mm; }
      body { background:#fff; }
      .resume { max-width:none; margin:0; padding:0; }
      .hero {
        border-radius:0;
        box-shadow:none;
        -webkit-print-color-adjust:exact;
        print-color-adjust:exact;
      }
      .section { box-shadow:none; margin-top:9px; }
      .section, .job, .project, .skill-card, .education { break-inside:avoid; }
      a { text-decoration:none; }
      .footer { display:none; }
    }
  </style>
</head>

