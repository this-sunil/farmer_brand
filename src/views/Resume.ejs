<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Sunil Shedge — Senior Flutter Developer with 4+ years of experience building scalable production-ready Flutter applications, backend systems and cloud integrations."
  >

  <title>Sunil Shedge | Senior Flutter Developer</title>


  <!-- =========================================================
       BOOTSTRAP 5
  ========================================================== -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >


  <!-- =========================================================
       BOOTSTRAP ICONS
  ========================================================== -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >


  <!-- =========================================================
       GOOGLE FONTS
  ========================================================== -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >


  <!-- =========================================================
       CUSTOM CSS
  ========================================================== -->

  <style>

    /* =========================================================
       ROOT
    ========================================================== */

    :root {

      --bg: #f5f8f3;

      --white: #ffffff;

      --dark: #172016;

      --dark-2: #253025;

      --text: #344034;

      --muted: #687267;

      --light: #8b958b;

      --green: #8bcf3f;

      --green-dark: #65a52a;

      --green-soft: #eaf7dc;

      --green-soft-2: #f3faeb;

      --border: #dfe9d9;

      --orange: #f2a94a;

      --blue: #559bee;

      --red: #e45564;

      --purple: #9477e8;

      --shadow-sm:
        0 8px 25px rgba(36, 55, 35, 0.06);

      --shadow:
        0 18px 55px rgba(36, 55, 35, 0.09);

    }


    /* =========================================================
       GLOBAL
    ========================================================== */

    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      margin: 0;

      background:
        linear-gradient(
          180deg,
          #f5f8f3 0%,
          #ffffff 35%,
          #f5f8f3 100%
        );

      color: var(--text);

      font-family: "DM Sans", sans-serif;

      line-height: 1.6;

    }


    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {

      font-family: "Manrope", sans-serif;

      color: var(--dark);

    }


    a {
      text-decoration: none;
    }


    .container {
      max-width: 1180px;
    }


    .section-padding {
      padding: 100px 0;
    }


    .text-muted-custom {
      color: var(--muted);
    }


    /* =========================================================
       HERO
    ========================================================== */

    .hero {

      padding: 115px 0 90px;

      position: relative;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 90% 15%,
          rgba(139, 207, 63, 0.17),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #f5f8f3 0%,
          #ffffff 52%,
          #f0f7e9 100%
        );

    }


    .hero::before {

      content: "";

      position: absolute;

      width: 480px;

      height: 480px;

      border: 1px solid rgba(139, 207, 63, 0.16);

      border-radius: 50%;

      top: -240px;

      right: -140px;

    }


    .hero::after {

      content: "";

      position: absolute;

      width: 170px;

      height: 170px;

      border-radius: 50%;

      background: rgba(139, 207, 63, 0.08);

      left: -80px;

      bottom: -80px;

    }


    .hero-content {
      position: relative;
      z-index: 2;
    }


    /* =========================================================
       AVAILABILITY
    ========================================================== */

    .availability {

      display: inline-flex;

      align-items: center;

      gap: 9px;

      background: rgba(139, 207, 63, 0.10);

      border: 1px solid rgba(101, 165, 42, 0.20);

      color: var(--green-dark);

      padding: 8px 14px;

      border-radius: 100px;

      font-size: 11px;

      font-weight: 800;

      margin-bottom: 23px;

    }


    .availability-dot {

      width: 8px;

      height: 8px;

      background: #6db52d;

      border-radius: 50%;

      box-shadow:
        0 0 0 5px rgba(109, 181, 45, 0.10);

    }


    /* =========================================================
       HERO TITLE
    ========================================================== */

    .hero-title {

      font-family: "Manrope", sans-serif;

      font-size: clamp(48px, 6vw, 78px);

      line-height: 0.98;

      font-weight: 800;

      letter-spacing: -4px;

      color: var(--dark);

      margin: 0 0 18px;

    }


    .hero-title span {

      color: var(--green-dark);

    }


    /* =========================================================
       HERO POSITIONING
    ========================================================== */

    .hero-positioning {

      display: inline-block;

      font-size: 14px;

      font-weight: 800;

      color: var(--dark);

      background: white;

      border: 1px solid var(--border);

      padding: 8px 13px;

      border-radius: 8px;

      margin-bottom: 20px;

      box-shadow:
        0 5px 18px rgba(36, 55, 35, 0.04);

    }


    /* =========================================================
       HERO DESCRIPTION
    ========================================================== */

    .hero-description {

      max-width: 790px;

      color: var(--muted);

      font-size: 16px;

      line-height: 1.85;

      margin-bottom: 28px;

    }


    .hero-description strong {

      color: var(--dark);

      font-weight: 800;

    }


    /* =========================================================
       HERO BUTTONS
    ========================================================== */

    .hero-buttons {

      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 10px;

      margin-bottom: 43px;

    }


    .btn-primary-custom {

      background: var(--dark);

      border: 1px solid var(--dark);

      color: white;

      padding: 13px 20px;

      border-radius: 10px;

      font-size: 13px;

      font-weight: 800;

      transition: 0.2s ease;

    }


    .btn-primary-custom:hover {

      background: var(--green-dark);

      border-color: var(--green-dark);

      color: white;

      transform: translateY(-2px);

    }


    .btn-outline-custom {

      border: 1px solid var(--border);

      color: var(--dark);

      background: rgba(255,255,255,0.9);

      padding: 13px 19px;

      border-radius: 10px;

      font-size: 13px;

      font-weight: 800;

      transition: 0.2s ease;

    }


    .btn-outline-custom:hover {

      border-color: var(--green);

      color: var(--green-dark);

      background: white;

      transform: translateY(-2px);

    }


    /* =========================================================
       HERO STATS
    ========================================================== */

    .hero-stats {

      display: flex;

      align-items: stretch;

      flex-wrap: wrap;

      border-top: 1px solid var(--border);

      padding-top: 25px;

      max-width: 870px;

    }


    .hero-stat {

      min-width: 155px;

      padding: 0 25px;

      border-right: 1px solid var(--border);

    }


    .hero-stat:first-child {
      padding-left: 0;
    }


    .hero-stat:last-child {
      border-right: 0;
    }


    .hero-stat-number {

      font-family: "Manrope", sans-serif;

      color: var(--dark);

      font-size: 27px;

      line-height: 1;

      font-weight: 800;

      margin-bottom: 6px;

    }


    .hero-stat-label {

      color: var(--muted);

      font-size: 10px;

      line-height: 1.4;

      font-weight: 600;

    }


    /* =========================================================
       PROFILE CARD
    ========================================================== */

    .hero-profile-card {

      background: rgba(255,255,255,0.92);

      border: 1px solid var(--border);

      border-radius: 25px;

      padding: 25px;

      box-shadow:
        0 25px 65px rgba(36, 55, 35, 0.11);

      position: relative;

      z-index: 3;

    }


    /* =========================================================
       PROFILE HEADER
    ========================================================== */

    .profile-card-top {

      display: flex;

      align-items: center;

      gap: 14px;

    }


    .profile-avatar {

      width: 58px;

      height: 58px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 17px;

      background:
        linear-gradient(
          135deg,
          var(--dark),
          #344634
        );

      color: var(--green);

      font-family: "Manrope", sans-serif;

      font-size: 17px;

      font-weight: 800;

      box-shadow:
        0 10px 25px rgba(23, 32, 22, 0.18);

    }


    .profile-name {

      color: var(--dark);

      font-family: "Manrope", sans-serif;

      font-size: 15px;

      font-weight: 800;

    }


    .profile-role {

      color: var(--muted);

      font-size: 11px;

      margin-top: 2px;

    }


    /* =========================================================
       PROFILE DIVIDER
    ========================================================== */

    .profile-divider {

      height: 1px;

      background: var(--border);

      margin: 22px 0;

    }


    /* =========================================================
       PROFILE LABEL
    ========================================================== */

    .profile-section-label {

      color: var(--light);

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 1.6px;

      margin-bottom: 14px;

    }


    /* =========================================================
       PROFILE FOCUS
    ========================================================== */

    .profile-focus-list {

      display: flex;

      flex-direction: column;

      gap: 13px;

    }


    .profile-focus {

      display: flex;

      align-items: center;

      gap: 11px;

    }


    .profile-focus-icon {

      width: 35px;

      height: 35px;

      display: flex;

      align-items: center;

      justify-content: center;

      flex-shrink: 0;

      background: var(--green-soft);

      border: 1px solid #d9ebc8;

      color: var(--green-dark);

      border-radius: 9px;

      font-size: 14px;

    }


    .profile-focus strong {

      display: block;

      color: var(--dark);

      font-size: 11px;

      font-weight: 800;

    }


    .profile-focus small {

      display: block;

      color: var(--muted);

      font-size: 9px;

      margin-top: 2px;

    }


    /* =========================================================
       HERO TECH
    ========================================================== */

    .hero-tech-stack {

      display: flex;

      flex-wrap: wrap;

      gap: 6px;

    }


    .hero-tech-stack span {

      background: #f5f8f3;

      border: 1px solid var(--border);

      color: var(--text);

      border-radius: 7px;

      padding: 6px 8px;

      font-size: 9px;

      font-weight: 700;

    }


    /* =========================================================
       LOCATION
    ========================================================== */

    .profile-location {

      display: flex;

      align-items: center;

      gap: 7px;

      margin-top: 20px;

      color: var(--muted);

      font-size: 10px;

      font-weight: 600;

    }


    .profile-location i {

      color: var(--green-dark);

    }


    /* =========================================================
       SECTION HEADER
    ========================================================== */

    .section-label {

      color: var(--green-dark);

      text-transform: uppercase;

      font-size: 11px;

      font-weight: 800;

      letter-spacing: 2px;

      margin-bottom: 8px;

    }


    .section-title {

      font-size: 38px;

      font-weight: 800;

      letter-spacing: -1.5px;

      margin-bottom: 12px;

    }


    .section-description {

      color: var(--muted);

      max-width: 700px;

      line-height: 1.8;

    }


    /* =========================================================
       ABOUT
    ========================================================== */

    .about-card {

      background: white;

      border: 1px solid var(--border);

      border-radius: 24px;

      padding: 35px;

      box-shadow: var(--shadow-sm);

    }


    .about-card p {

      color: var(--muted);

      font-size: 14px;

      line-height: 1.9;

    }


    .about-card strong {

      color: var(--dark);

    }


    .focus-item {

      display: flex;

      gap: 14px;

      padding: 16px 0;

      border-bottom: 1px solid var(--border);

    }


    .focus-item:last-child {
      border-bottom: 0;
    }


    .focus-icon {

      width: 42px;

      height: 42px;

      flex-shrink: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 12px;

      background: var(--green-soft);

      color: var(--green-dark);

    }


    .focus-title {

      font-weight: 800;

      font-size: 14px;

      color: var(--dark);

    }


    .focus-text {

      color: var(--muted);

      font-size: 12px;

    }


    /* =========================================================
       SKILLS
    ========================================================== */

    .skill-card {

      height: 100%;

      background: white;

      border: 1px solid var(--border);

      border-radius: 18px;

      padding: 25px;

      transition: 0.25s ease;

    }


    .skill-card:hover {

      transform: translateY(-5px);

      box-shadow: var(--shadow-sm);

      border-color: #cce3b9;

    }


    .skill-icon {

      width: 45px;

      height: 45px;

      border-radius: 12px;

      background: var(--green-soft);

      color: var(--green-dark);

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 20px;

      margin-bottom: 17px;

    }


    .skill-card h3 {

      font-size: 16px;

      font-weight: 800;

      margin-bottom: 10px;

    }


    .skill-card p {

      color: var(--muted);

      font-size: 12px;

      line-height: 1.75;

      margin: 0;

    }


    .skill-card strong {

      color: var(--dark);

    }


    /* =========================================================
       EXPERIENCE
    ========================================================== */

    .experience-card {

      background: white;

      border: 1px solid var(--border);

      border-radius: 20px;

      padding: 30px;

      margin-bottom: 20px;

      box-shadow: var(--shadow-sm);

    }


    .experience-company {

      color: var(--green-dark);

      font-weight: 800;

      font-size: 14px;

    }


    .experience-role {

      font-size: 22px;

      font-weight: 800;

      margin: 4px 0;

    }


    .experience-period {

      color: var(--muted);

      font-size: 12px;

      font-weight: 600;

    }


    .experience-list {

      margin: 20px 0 0;

      padding-left: 20px;

    }


    .experience-list li {

      color: var(--muted);

      font-size: 13px;

      margin-bottom: 8px;

      line-height: 1.7;

    }


    .experience-list strong {

      color: var(--dark);

    }


    /* =========================================================
       EXPERIENCE METRICS
    ========================================================== */

    .metric {

      background: var(--green-soft-2);

      border: 1px solid var(--border);

      border-radius: 15px;

      padding: 18px;

      height: 100%;

    }


    .metric-number {

      font-size: 24px;

      font-weight: 800;

      color: var(--green-dark);

    }


    .metric-label {

      font-size: 11px;

      color: var(--muted);

    }


    /* =========================================================
       PROJECTS
    ========================================================== */

    .featured-project {

      background: var(--dark);

      color: white;

      border-radius: 26px;

      padding: 38px;

      margin-bottom: 30px;

      overflow: hidden;

      position: relative;

    }


    .featured-project::after {

      content: "";

      position: absolute;

      width: 330px;

      height: 330px;

      border-radius: 50%;

      background: rgba(139, 207, 63, 0.10);

      right: -110px;

      bottom: -170px;

    }


    .featured-project .project-number {

      color: var(--green);

    }


    .featured-project .project-title {

      color: white;

      font-size: 35px;

    }


    .featured-project .project-category {

      color: #aeb8ae;

    }


    .featured-project .project-description {

      color: #c1c9c1;

      max-width: 820px;

      font-size: 14px;

      line-height: 1.8;

    }


    .featured-project .project-features li {

      color: #c1c9c1;

    }


    .featured-project .project-features strong {

      color: white;

    }


    .featured-project .tech {

      background: rgba(255,255,255,0.06);

      border-color: rgba(255,255,255,0.10);

      color: #dbe2db;

    }


    .project-card {

      background: white;

      border: 1px solid var(--border);

      border-radius: 24px;

      overflow: hidden;

      height: 100%;

      transition: 0.25s ease;

    }


    .project-card:hover {

      transform: translateY(-6px);

      box-shadow: var(--shadow);

    }


    .project-top {

      padding: 27px;

      background:
        linear-gradient(
          135deg,
          #f0f8e8,
          #ffffff
        );

      border-bottom: 1px solid var(--border);

    }


    .project-number {

      color: var(--green-dark);

      font-size: 10px;

      font-weight: 800;

      letter-spacing: 1.5px;

    }


    .project-title {

      font-size: 23px;

      font-weight: 800;

      margin: 8px 0;

    }


    .project-category {

      color: var(--muted);

      font-size: 12px;

    }


    .project-body {

      padding: 27px;

    }


    .project-description {

      color: var(--muted);

      font-size: 13px;

      line-height: 1.8;

      margin-bottom: 20px;

    }


    .project-features {

      margin: 0;

      padding-left: 18px;

    }


    .project-features li {

      color: var(--text);

      font-size: 12px;

      margin-bottom: 7px;

    }


    .project-features strong {

      color: var(--dark);

    }


    .tech-list {

      display: flex;

      flex-wrap: wrap;

      gap: 6px;

      margin-top: 20px;

    }


    .tech {

      background: #f6f8f5;

      border: 1px solid var(--border);

      color: var(--text);

      padding: 5px 9px;

      border-radius: 6px;

      font-size: 10px;

      font-weight: 600;

    }


    .project-footer {

      padding: 0 27px 27px;

    }


    .project-link {

      display: inline-flex;

      align-items: center;

      gap: 6px;

      color: var(--green-dark);

      font-size: 12px;

      font-weight: 800;

    }


    .project-link:hover {
      color: var(--dark);
    }


    /* =========================================================
       TECH STACK
    ========================================================== */

    .stack-box {

      background: white;

      border: 1px solid var(--border);

      border-radius: 20px;

      padding: 28px;

      height: 100%;

    }


    .stack-title {

      font-weight: 800;

      font-size: 16px;

      margin-bottom: 15px;

    }


    .stack-tags {

      display: flex;

      flex-wrap: wrap;

      gap: 8px;

    }


    .stack-tag {

      padding: 7px 11px;

      background: var(--green-soft-2);

      border: 1px solid var(--border);

      border-radius: 8px;

      font-size: 11px;

      font-weight: 600;

      color: var(--text);

    }


    /* =========================================================
       EDUCATION
    ========================================================== */

    .education-card {

      background: white;

      border: 1px solid var(--border);

      border-radius: 20px;

      padding: 25px;

      height: 100%;

    }


    .education-degree {

      font-size: 17px;

      font-weight: 800;

      color: var(--dark);

    }


    .education-school {

      color: var(--green-dark);

      font-size: 12px;

      font-weight: 700;

      margin: 4px 0;

    }


    .education-year {

      color: var(--muted);

      font-size: 11px;

    }


    /* =========================================================
       CERTIFICATE
    ========================================================== */

    .certificate {

      background:
        linear-gradient(
          135deg,
          #eaf7dc,
          #ffffff
        );

      border: 1px solid var(--border);

      border-radius: 22px;

      padding: 30px;

    }


    .certificate-icon {

      width: 52px;

      height: 52px;

      border-radius: 14px;

      background: white;

      display: flex;

      align-items: center;

      justify-content: center;

      color: var(--green-dark);

      font-size: 23px;

      border: 1px solid var(--border);

    }


    /* =========================================================
       CONTACT
    ========================================================== */

    .contact-section {

      background: var(--dark);

      color: white;

    }


    .contact-section .section-title {

      color: white;

    }


    .contact-section .section-label {

      color: var(--green);

    }


    .contact-section .section-description {

      color: #aeb8ae;

    }


    .contact-box {

      background: rgba(255,255,255,0.05);

      border: 1px solid rgba(255,255,255,0.10);

      border-radius: 16px;

      padding: 20px;

      height: 100%;

    }


    .contact-icon {

      color: var(--green);

      font-size: 19px;

      margin-bottom: 10px;

    }


    .contact-label {

      color: #909a90;

      font-size: 10px;

      text-transform: uppercase;

      letter-spacing: 1px;

    }


    .contact-value {

      color: white;

      font-size: 13px;

      font-weight: 600;

      word-break: break-word;

    }


    .contact-value:hover {

      color: var(--green);

    }


    /* =========================================================
       FOOTER
    ========================================================== */

    footer {

      background: #111710;

      color: #7f887f;

      font-size: 11px;

      padding: 20px 0;

    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @media (max-width: 991px) {

      .hero {

        padding-top: 95px;

      }


      .hero-profile-card {

        max-width: 600px;

        margin: 0 auto;

      }

    }


    @media (max-width: 767px) {

      .section-padding {

        padding: 70px 0;

      }


      .hero {

        padding: 90px 0 70px;

      }


      .hero-title {

        font-size: 47px;

        letter-spacing: -2.5px;

      }


      .hero-positioning {

        font-size: 11px;

      }


      .hero-description {

        font-size: 14px;

      }


      .hero-buttons {

        margin-bottom: 35px;

      }


      .hero-stats {

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 20px;

      }


      .hero-stat {

        min-width: 0;

        padding: 0;

        border-right: 0;

      }


      .hero-stat-number {

        font-size: 23px;

      }


      .section-title {

        font-size: 30px;

      }


      .experience-card {

        padding: 22px;

      }


      .featured-project {

        padding: 25px;

      }


      .featured-project .project-title {

        font-size: 27px;

      }


      .project-top,
      .project-body {

        padding: 22px;

      }


      .project-footer {

        padding: 0 22px 22px;

      }

    }


    /* =========================================================
       PRINT / PDF
    ========================================================== */

    @media print {

      body {

