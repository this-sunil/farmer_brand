<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Sunil Shedge — Senior Flutter Developer with 4+ years of experience building production Android, iOS, and Web applications."
    />
    <meta name="theme-color" content="#0d9488" />
    <meta name="color-scheme" content="light" />

    <title>Sunil Shedge | Senior Flutter Developer</title>

    <link
      rel="icon"
      href="https://avatars.githubusercontent.com/u/51407211?v=4"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      :root {
        --primary: #0d9488;
        --primary-dark: #0f766e;
        --primary-soft: #ecfdf5;

        --accent: #f59e0b;
        --accent-soft: #fffbeb;

        --dark: #101828;
        --text: #344054;
        --muted: #667085;

        --border: #e4e7ec;
        --light: #f8fafc;
        --paper: #ffffff;
        --page: #eef2f6;

        --radius: 12px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 40px 0;
        background:
          radial-gradient(
            circle at top left,
            rgba(13, 148, 136, 0.07),
            transparent 30%
          ),
          var(--page);
        color: var(--text);
        font-family: "DM Sans", sans-serif;
        line-height: 1.6;
      }

      h1,
      h2,
      h3,
      h4,
      h5 {
        font-family: "Manrope", sans-serif;
      }

      a {
        text-decoration: none;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* =========================
         RESUME
      ========================== */

      .resume {
        max-width: 1120px;
        margin: auto;
        background: var(--paper);
        border-radius: 18px;
        overflow: hidden;
        box-shadow:
          0 25px 80px rgba(16, 24, 40, 0.12),
          0 5px 20px rgba(16, 24, 40, 0.05);
      }

      /* =========================
         HEADER
      ========================== */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 46px 52px 40px;
        background: linear-gradient(
          135deg,
          #0b1220 0%,
          #111827 60%,
          #0f766e 140%
        );
        color: #fff;
      }

      .hero::before {
        content: "";
        position: absolute;
        width: 340px;
        height: 340px;
        right: -120px;
        top: -180px;
        border-radius: 50%;
        background: rgba(20, 184, 166, 0.15);
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        left: -150px;
        bottom: -170px;
        border-radius: 50%;
        background: rgba(245, 158, 11, 0.08);
      }

      .hero-content {
        position: relative;
        z-index: 2;
      }

      .availability {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 17px;
        padding: 6px 12px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.09);
        color: #d1fae5;
        font-size: 11px;
        font-weight: 700;
      }

      .availability-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.12);
        flex: 0 0 auto;
      }

      .name {
        margin: 0;
        color: #fff;
        font-size: clamp(2.3rem, 5vw, 4rem);
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1;
      }

      .role {
        margin-top: 13px;
        color: #5eead4;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
      }

      .hero-description {
        max-width: 760px;
        margin-top: 18px;
        margin-bottom: 0;
        color: #cbd5e1;
        font-size: 13px;
        line-height: 1.8;
      }

      .contact-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 27px;
      }

      .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 11px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.065);
        color: #e2e8f0;
        font-size: 11px;
        transition:
          background 0.2s ease,
          color 0.2s ease,
          border-color 0.2s ease;
      }

      .contact-item:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.22);
      }

      .contact-item i {
        color: #5eead4;
        font-size: 13px;
      }

      /* =========================
         MAIN
      ========================== */

      .main {
        padding: 40px 52px 50px;
      }

      .section {
        margin-bottom: 38px;
      }

      .section:last-child {
        margin-bottom: 0;
      }

      .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 18px;
      }

      .section-icon {
        width: 33px;
        height: 33px;
        display: inline-flex;
        flex: 0 0 33px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--primary-soft);
        color: var(--primary-dark);
        font-size: 15px;
      }

      .section-title {
        margin: 0;
        color: var(--dark);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
      }

      .section-line {
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      /* =========================
         SUMMARY
      ========================== */

      .summary-box {
        padding: 20px 22px;
        border: 1px solid #d1fae5;
        border-left: 4px solid var(--primary);
        border-radius: 11px;
        background: linear-gradient(135deg, #f0fdfa, #fff);
      }

      .summary-box p {
        margin: 0;
        color: #344054;
        font-size: 13px;
        line-height: 1.85;
      }

      .summary-box strong {
        color: var(--dark);
      }

      .highlight {
        color: var(--primary-dark);
        font-weight: 800;
      }

      /* =========================
         SKILLS
      ========================== */

      .skills-panel {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }

      .skill-row {
        display: grid;
        grid-template-columns: 190px 1fr;
        gap: 20px;
        padding: 14px 17px;
        border-bottom: 1px solid var(--border);
        transition: background 0.15s ease;
      }

      .skill-row:hover {
        background: #fafcff;
      }

      .skill-row:last-child {
        border-bottom: 0;
      }

      .skill-label {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: var(--dark);
        font-size: 11px;
        font-weight: 800;
      }

      .skill-label i {
        margin-top: 2px;
        color: var(--primary);
      }

      .skill-content {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-content: flex-start;
      }

      .skill-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border: 1px solid #e4e7ec;
        border-radius: 6px;
        background: #f8fafc;
        color: #475467;
        font-size: 10px;
        font-weight: 600;
      }

      .skill-badge.primary {
        border-color: #ccfbf1;
        background: var(--primary-soft);
        color: var(--primary-dark);
      }

      /* =========================
         EXPERIENCE
      ========================== */

      .experience {
        position: relative;
      }

      .experience::before {
        content: "";
        position: absolute;
        top: 8px;
        bottom: 8px;
        left: 13px;
        width: 2px;
        background: #e2e8f0;
      }

      .experience-item {
        position: relative;
        padding-left: 44px;
        margin-bottom: 31px;
      }

      .experience-item:last-child {
        margin-bottom: 0;
      }

      .experience-dot {
        position: absolute;
        z-index: 2;
        top: 4px;
        left: 5px;
        width: 18px;
        height: 18px;
        border: 4px solid var(--primary);
        border-radius: 50%;
        background: #fff;
      }

      .experience-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 4px;
      }

      .job-title {
        margin: 0;
        color: var(--dark);
        font-size: 15px;
        font-weight: 800;
      }

      .company {
        margin-top: 3px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 700;
      }

      .date {
        white-space: nowrap;
        padding: 5px 9px;
        border-radius: 6px;
        background: var(--accent-soft);
        color: #92650a;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
      }

      .job-list {
        margin: 13px 0 0;
        padding-left: 17px;
      }

      .job-list li {
        padding-left: 3px;
        margin-bottom: 7px;
        color: #475467;
        font-size: 11.7px;
        line-height: 1.65;
      }

      .job-list li::marker {
        color: var(--primary);
      }

      .job-list strong {
        color: var(--dark);
        font-weight: 700;
      }

      .job-list code {
        padding: 1px 4px;
        border-radius: 4px;
        background: #f1f5f9;
        color: #334155;
        font-size: 10px;
      }

      /* =========================
         PROJECTS
      ========================== */

      .project-card {
        position: relative;
        height: 100%;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #fff;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .project-card:hover {
        transform: translateY(-3px);
        border-color: #99f6e4;
        box-shadow: 0 12px 30px rgba(15, 118, 110, 0.08);
      }

      .project-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
      }

      .project-icon {
        width: 37px;
        height: 37px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--primary-soft);
        color: var(--primary-dark);
        font-size: 16px;
        flex: 0 0 auto;
      }

      .project-tag {
        display: block;
        color: #92650a;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .project-title {
        margin: 3px 0 0;
        color: var(--dark);
        font-size: 13px;
        font-weight: 800;
      }

      .project-description {
        margin: 0 0 11px;
        color: var(--muted);
        font-size: 10.8px;
        line-height: 1.65;
      }

      .project-description em {
        color: #475467;
        font-style: normal;
      }

      .project-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--primary-dark);
        font-size: 10px;
        font-weight: 800;
      }

      .project-link:hover {
        color: #92650a;
      }

      /* =========================
         EDUCATION
      ========================== */

      .education-list {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 11px;
      }

      .education-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 17px;
        border-bottom: 1px solid var(--border);
      }

      .education-item:last-child {
        border-bottom: 0;
      }

      .degree {
        color: var(--dark);
        font-size: 11px;
        font-weight: 800;
      }

      .school {
        margin-top: 3px;
        color: var(--muted);
        font-size: 10px;
      }

      .edu-year {
        white-space: nowrap;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
      }

      /* =========================
         CREDENTIAL
      ========================== */

      .certificate {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 17px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: linear-gradient(135deg, #fff, #f8fafc);
      }

      .certificate-left {
        display: flex;
        align-items: center;
        gap: 11px;
      }

      .certificate-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--accent-soft);
        color: #92650a;
        font-size: 17px;
        flex: 0 0 auto;
      }

      .certificate-title {
        color: var(--dark);
        font-size: 11px;
        font-weight: 800;
      }

      .certificate-subtitle {
        color: var(--muted);
        font-size: 9px;
      }

      /* =========================
         FOOTER
      ========================== */

      .resume-footer {
        padding: 18px 52px;
        border-top: 1px solid var(--border);
        background: var(--light);
        color: var(--muted);
        font-size: 10px;
        text-align: center;
      }

      /* =========================
         RESPONSIVE
      ========================== */

      @media (max-width: 991.98px) {
        body {
          padding: 20px 0;
        }

        .resume {
          margin: 0 14px;
        }

        .hero,
        .main,
        .resume-footer {
          padding-left: 30px;
          padding-right: 30px;
        }
      }

      @media (max-width: 767.98px) {
        body {
          padding: 0;
          background: #fff;
        }

        .resume {
          margin: 0;
          border-radius: 0;
          box-shadow: none;
        }

        .hero {
          padding: 35px 22px 29px;
        }

        .name {
          font-size: 2.5rem;
        }

        .role {
          font-size: 10px;
          letter-spacing: 1.8px;
        }

        .contact-grid {
          flex-direction: column;
          align-items: stretch;
        }

        .contact-item {
          width: 100%;
        }

        .main,
        .resume-footer {
          padding-right: 22px;
          padding-left: 22px;
        }

        .skill-row {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .experience-header {
          flex-direction: column;
        }

        .date {
          align-self: flex-start;
        }

        .education-item,
        .certificate {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      /* =========================
         REDUCED MOTION
      ========================== */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .project-card,
        .contact-item,
        .skill-row {
          transition: none;
        }

        .project-card:hover {
          transform: none;
        }
      }

      /* =========================
         PRINT / A4
      ========================== */

      @media print {
        @page {
          size: A4;
          margin: 7mm;
        }

        html,
        body {
          width: 210mm;
          min-height: 297mm;
        }

        body {
          padding: 0;
          background: #fff !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .resume {
          width: 100%;
          max-width: none;
          margin: 0;
          border-radius: 0;
          box-shadow: none;
        }

        .hero {
          break-inside: avoid;
        }

        .section {
          break-inside: auto;
        }

        .section-heading,
        .summary-box,
        .skills-panel,
        .experience-item,
        .project-card,
        .education-item,
        .certificate {
          break-inside: avoid;
        }

        .project-card:hover {
          transform: none;
          box-shadow: none;
        }

        a {
          color: inherit;
        }

        .project-link,
        .contact-item {
          text-decoration: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="resume">
      <!-- =====================================================
           HEADER
      ====================================================== -->

      <header class="hero">
        <div class="hero-content">
          <div class="availability">
            <span class="availability-dot" aria-hidden="true"></span>
            Available for Senior Flutter Opportunities
          </div>

          <h1 class="name">Sunil Shedge</h1>

          <div class="role">
            Senior Flutter Developer &middot; Mobile Application Engineer
          </div>

          <p class="hero-description">
            Building scalable, secure, and high-performance Android and iOS
            applications using Flutter, Dart, modern architecture, backend
            systems, APIs, payment integrations, cloud services, and CI/CD.
          </p>

          <div class="contact-grid">
            <a class="contact-item" href="mailto:swarajya888@gmail.com">
              <i class="bi bi-envelope-fill" aria-hidden="true"></i>
              swarajya888@gmail.com
            </a>

            <a class="contact-item" href="tel:+918668796251">
              <i class="bi bi-telephone-fill" aria-hidden="true"></i>
              +91 8668796251
            </a>

            <span class="contact-item">
              <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
              Pune, Maharashtra, India
            </span>

            <a
              class="contact-item"
              href="https://farmer-brand.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-globe2" aria-hidden="true"></i>
              Portfolio
            </a>

            <a
              class="contact-item"
              href="https://linkedin.com/in/sunilshedge"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-linkedin" aria-hidden="true"></i>
              LinkedIn
            </a>

            <a
              class="contact-item"
              href="https://github.com/this-sunil"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-github" aria-hidden="true"></i>
              GitHub
            </a>
          </div>
        </div>
      </header>

      <!-- =====================================================
           MAIN CONTENT
      ====================================================== -->

      <main class="main">
        <!-- ================= SUMMARY ================= -->

        <section class="section" aria-labelledby="summary-heading">
          <div class="section-heading">
            <div class="section-icon">
              <i class="bi bi-person-badge" aria-hidden="true"></i>
            </div>

            <h2 class="section-title" id="summary-heading">
              Professional Summary
            </h2>

            <div class="section-line"></div>
          </div>

          <div class="summary-box">
            <p>
              Senior Flutter Developer with
              <span class="highlight">4+ years</span>
              of hands-on experience designing, developing, and deploying
              scalable Android and iOS applications. Successfully delivered
              <span class="highlight">15+ production apps</span>
              with live deployments on the Google Play Store and Apple App
              Store. Strong expertise in
              <strong
                >Flutter, Dart, BLoC, REST APIs, Firebase, Google Maps,
                Razorpay, Stripe, UPI, biometric authentication, WebView, and
                CI/CD</strong
              >, with a strong focus on clean architecture, performance
              optimization, application security, and reliable production
              delivery.
            </p>
          </div>
        </section>

        <!-- ================= TECHNICAL SKILLS ================= -->

        <section class="section" aria-labelledby="skills-heading">
          <div class="section-heading">
            <div class="section-icon">
              <i class="bi bi-code-slash" aria-hidden="true"></i>
            </div>

            <h2 class="section-title" id="skills-heading">Technical Skills</h2>

            <div class="section-line"></div>
          </div>

          <div class="skills-panel">
            <!-- Mobile -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-phone" aria-hidden="true"></i>
                Mobile Development
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">Flutter</span>
                <span class="skill-badge primary">Dart</span>
                <span class="skill-badge">Android</span>
                <span class="skill-badge">iOS</span>
                <span class="skill-badge">Flutter Web</span>
                <span class="skill-badge">Responsive UI</span>
                <span class="skill-badge">WebView</span>
              </div>
            </div>

            <!-- Architecture -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-layers" aria-hidden="true"></i>
                Architecture
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">Clean Architecture</span>
                <span class="skill-badge primary">BLoC</span>
                <span class="skill-badge">MVVM</span>
                <span class="skill-badge">SOLID Principles</span>
                <span class="skill-badge">Repository Pattern</span>
                <span class="skill-badge">Dependency Injection</span>
              </div>
            </div>

            <!-- State Management -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                State Management
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">BLoC</span>
                <span class="skill-badge">GetX</span>
                <span class="skill-badge">Provider</span>
                <span class="skill-badge">Riverpod</span>
              </div>
            </div>

            <!-- Backend -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-server" aria-hidden="true"></i>
                Backend &amp; Database
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">Node.js</span>
                <span class="skill-badge">Express.js</span>
                <span class="skill-badge">PostgreSQL</span>
                <span class="skill-badge">Firebase</span>
                <span class="skill-badge">Cloud Firestore</span>
