      <!-- =====================================================
       MAIN CONTENT
  ====================================================== -->

      <main class="main">
        <!-- ================= SUMMARY ================= -->

        <section class="section">
          <div class="section-heading">
            <div class="section-icon">
              <i class="bi bi-person-badge"></i>
            </div>

            <h2 class="section-title">Professional Summary</h2>

            <div class="section-line"></div>
          </div>

          <div class="summary-box">
            <p>
              Senior Flutter Developer with
              <span class="highlight">4+ years</span>
              of experience building scalable, high-performance Android and iOS
              applications. Developed
              <span class="highlight">15+ mobile apps</span>
              with live deployments on Play Store and App Store. Strong
              expertise in
              <strong
                >Flutter, Dart, BLoC architecture, REST APIs, Firebase, Google
                Maps</strong
              >, and payment gateways such as
              <strong>Razorpay and UPI</strong> — delivering stable, optimized
              apps focused on performance, monetization, and user engagement.
            </p>
          </div>
        </section>

        <!-- ================= TECH STACK ================= -->

        <section class="section">
          <div class="section-heading">
            <div class="section-icon">
              <i class="bi bi-code-slash"></i>
            </div>

            <h2 class="section-title">Technical Skills</h2>

            <div class="section-line"></div>
          </div>

          <div class="skills-panel">
            <!-- Mobile -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-phone"></i>
                Mobile
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">Flutter</span>
                <span class="skill-badge primary">Dart</span>
                <span class="skill-badge">Android</span>
                <span class="skill-badge">iOS</span>
                <span class="skill-badge">Web</span>
              </div>
            </div>

            <!-- State Management -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-diagram-3"></i>
                State Management
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">BLoC</span>
                <span class="skill-badge">Riverpod</span>
                <span class="skill-badge">Provider</span>
                <span class="skill-badge">GetX</span>
              </div>
            </div>

            <!-- Backend -->

            <div class="skill-row">
              <div class="skill-label">
                <i class="bi bi-database"></i>
                Backend & Database
              </div>

              <div class="skill-content">
                <span class="skill-badge primary">Node.js</span>
                <span class="skill-badge">Express.js</span>
                <span class="skill-badge">PostgreSQL</span>
                <span class="skill-badge">JWT Authentication</span>
                <span class="skill-badge">Firebase</span>
                <span class="skill-badge">Cloud Firestore</span>
                <span class="skill-badge">Supabase</span>
                <span class="skill-badge">SQLite</span>
                <span class="skill-badge">Hive</span>
              </div>
